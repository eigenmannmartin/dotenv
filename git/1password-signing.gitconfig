# 1Password SSH-based git commit signing (macOS host).
#
# Your ~/.gitconfig already sets:
#     [gpg]    format = ssh
#     [commit] gpgsign = true
#     [user]   signingkey = ssh-rsa AAAA…   (the public half of your 1Password key)
#
# This fragment points git at 1Password's signer so commits are signed by the
# YubiKey-backed key held in 1Password (with a 1Password approval prompt),
# instead of relying on the key being loaded into a plain ssh-agent.
#
# Activate it on a macOS host with:
#     git config --global include.path "$(pwd)/git/1password-signing.gitconfig"
# (Do NOT include this inside a devcontainer — op-ssh-sign is not present there;
#  in a container, signing falls back to the forwarded host SSH agent.)

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
