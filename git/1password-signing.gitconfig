# 1Password SSH-based git commit signing (macOS host).
# Usage: git config --global include.path "$(pwd)/git/1password-signing.gitconfig"
# Do NOT include in a devcontainer: op-ssh-sign is absent; signing falls back to the forwarded host SSH agent.

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
