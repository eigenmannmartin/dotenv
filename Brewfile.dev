# dotenv macOS dependencies — "dev" feature: the CONTAINER layer only.
# Pulled in when DOTENV_FEATURES contains "dev", *on top of* Brewfile.devlite (the
# editor/runtime half, which `dev` implies) — so `brew bundle --file Brewfile.dev`
# alone installs only what is listed here. Both files together are what "dev" used
# to be before the split.
#
# OrbStack is a macOS app: there is no Linux build, so in a VM the engine comes from
# the separate "docker" feature (apt docker.io) instead. It bundles its own
# docker/compose/kubectl, which is also where Brewfile.k8s expects kubectl to come
# from; first run is interactive (open the app once for CLI symlinks).
cask "orbstack"
brew "lazydocker"   # TUI dashboard for Docker (containers, images, logs)
brew "ctop"         # top-like live CPU/mem/net per container
brew "dive"         # inspect a Docker image layer by layer
