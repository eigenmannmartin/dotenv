# dotenv macOS dependencies — "k8s" feature. Cluster inspection tooling.
# Pulled in when DOTENV_FEATURES contains "k8s". kubectl itself comes from OrbStack
# (Brewfile.dev), so enable "dev" — not just "devlite" — alongside this on a Mac that
# talks to clusters. Linux has no OrbStack, so the install script fetches kubectl from
# dl.k8s.io there instead. helmfmt has no formula: the install script fetches its
# release binary on both OSes.
tap "nklmilojevic/sofka"
brew "nklmilojevic/sofka/sofka"   # Kubernetes TUI (Rust): any CRD, Flux/Argo actions, incident view
brew "kubecolor"    # colorized kubectl (~/.zshrc aliases kubectl to it; `k` expands to it)
brew "kubectx"      # switch kube contexts + namespaces (installs kubens)
brew "stern"        # tail logs across many Kubernetes pods at once
brew "helm"         # Kubernetes package manager (charts)
brew "argocd"       # Argo CD CLI (cluster runs it in the argocd namespace)
