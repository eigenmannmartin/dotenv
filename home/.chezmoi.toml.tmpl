{{/*
  Generates ~/.config/chezmoi/chezmoi.toml. Runs at `chezmoi init` ONLY — never on
  a bare `chezmoi apply` — so this is where per-machine choices get frozen.

  Must live in home/ (the .chezmoiroot dir). A copy at the repo root is silently
  ignored: chezmoi reads .chezmoiroot first, and every special file is then
  resolved relative to the directory it names.

  It MUST emit sourceDir. `chezmoi init` overwrites this config file wholesale
  (with or without --force), so anything install.sh wrote here beforehand is
  destroyed — without this line every later bare `chezmoi apply` would fail with
  "stat ~/.local/share/chezmoi: no such file or directory". This replaces the
  hand-written config install.sh used to maintain, and fixes the stale-sourceDir
  case for free: re-running init from a new checkout re-renders it.

  sourceDir is derived from .chezmoi.sourceDir (which .chezmoiroot makes
  <repo>/home) by stripping one level. NOT .chezmoi.workingTree: that walks up to
  the nearest enclosing git repo, so a checkout nested inside another repo — a
  worktree, or ~/code/dotfiles inside a monorepo — would silently point chezmoi at
  the OUTER repo and apply the wrong tree.
*/ -}}
sourceDir = {{ .chezmoi.sourceDir | dir | quote }}

[data]
{{/*
  Precedence: DOTENV_FEATURES > this machine's stored choice > "core".

  The literal "core" default is deliberate: .chezmoidata.toml is NOT loaded while
  this template renders (verified — referencing .features here aborts init with
  `map has no entry`), even though it IS available to every other template on apply.

  A config that exists but has no features key predates features (it held only a
  sourceDir). There is no legacy fallback for it any more: it is frozen at core like
  a fresh machine, so say so on stderr instead of letting it shrink silently. Any
  change to this file makes chezmoi print "config file template has changed, run
  chezmoi init" on the next apply, so such a machine reaches this warning on its own.
  (warnf needs chezmoi >= 2.59, Jan 2025. An older chezmoi cannot parse this file at
  all, so init fails on every machine; fix with `brew upgrade chezmoi` or `chezmoi
  upgrade`. install.sh and the Brewfile only ever install a missing chezmoi, never
  upgrade one.)

  Deliberately no prompt: init has to work unattended in a Lima provisioning
  script. (Also, `(env "X") | default (promptOnce ...)` is a trap — Go templates
  evaluate the argument eagerly, so it prompts even when the env var IS set.)
*/ -}}
{{- $known := list "core" "devlite" "dev" "k8s" "vpn" "ai" "docker" "flutter" -}}
{{- $features := list "core" -}}
{{- if hasKey . "features" -}}
{{-   $features = .features -}}
{{- else if and (stat .chezmoi.configFile) (not (env "DOTENV_FEATURES")) -}}
{{-   warnf "%s has no [data] features key, so this machine is now frozen at features = [\"core\"]. To keep more, re-run install.sh with e.g. DOTENV_FEATURES=core,dev,k8s,vpn" .chezmoi.configFile -}}
{{- end -}}
{{- if env "DOTENV_FEATURES" -}}
{{-   $parsed := list -}}
{{/*  Trim each entry: "core, dev" is the obvious thing to type, and without this
      it yields a " dev" that matches nothing and is then frozen into the config.
      Unknown names abort init rather than silently installing less than asked. */ -}}
{{-   range (splitList "," (env "DOTENV_FEATURES")) -}}
{{-     $f := trim . -}}
{{-     if $f -}}
{{-       if not (has $f $known) -}}
{{-         fail (printf "DOTENV_FEATURES: unknown feature %q (known: %s)" $f (join ", " $known)) -}}
{{-       end -}}
{{-       $parsed = append $parsed $f -}}
{{-     end -}}
{{-   end -}}
{{-   if not $parsed -}}
{{-     fail "DOTENV_FEATURES is set but empty" -}}
{{-   end -}}
{{-   $features = $parsed -}}
{{- end }}
  features = {{ $features | toJson }}
