
# Ensure ~/.local/bin is on PATH.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# sbin on PATH for Linux. Lima appends exactly this to ~/.zshrc on every VM ("Lima
# BEGIN/END", for iptables + mount.fuse3) — but chezmoi owns ~/.zshrc and overwrites
# it on the next apply, silently dropping those tools off PATH and leaving an endless
# "has changed since chezmoi last wrote it" conflict. Owning the setting here makes
# chezmoi's overwrite lossless.
if [ "$(uname -s)" = "Linux" ]; then
  case ":$PATH:" in *":/usr/sbin:"*) ;; *) export PATH="$PATH:/usr/sbin:/sbin" ;; esac
fi

# Guarded so a Linux container without Homebrew no-ops.
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

command -v rbenv >/dev/null && eval "$(rbenv init - --no-rehash zsh)"

# Guarded so machines without OrbStack no-op cleanly.
[ -f "$HOME/.orbstack/shell/init.zsh" ] && source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :
