# ~/.local/bin and Linux sbin are on PATH already: .zshenv adds both, for every zsh.

# Guarded so a Linux container without Homebrew no-ops.
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

command -v rbenv >/dev/null && eval "$(rbenv init - --no-rehash zsh)"

# Guarded so machines without OrbStack no-op cleanly.
[ -f "$HOME/.orbstack/shell/init.zsh" ] && source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || :
