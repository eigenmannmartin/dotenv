# Esc-Esc toggles leading `sudo` (on empty line, prefixes previous command).
_sudo_toggle() {
  if [[ -z "$BUFFER" ]]; then
    BUFFER="sudo $(fc -ln -1)"; CURSOR=$#BUFFER
  elif [[ "$BUFFER" == sudo\ * ]]; then
    BUFFER="${BUFFER#sudo }"; (( CURSOR -= 5 ))
  else
    BUFFER="sudo $BUFFER"; (( CURSOR += 5 ))
  fi
}
