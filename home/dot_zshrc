# --- Key bindings ---------------------------------------------------------
# Esc-Esc: toggle a leading `sudo` on the command line (on an empty line it
# prefixes the PREVIOUS command). Bound in both emacs and vi-insert keymaps.
_sudo_toggle() {
  if [[ -z "$BUFFER" ]]; then
    BUFFER="sudo $(fc -ln -1)"; CURSOR=$#BUFFER
  elif [[ "$BUFFER" == sudo\ * ]]; then
    BUFFER="${BUFFER#sudo }"; (( CURSOR -= 5 ))
  else
    BUFFER="sudo $BUFFER"; (( CURSOR += 5 ))
  fi
}
zle -N _sudo_toggle
bindkey -M emacs '\e\e' _sudo_toggle
bindkey -M viins '\e\e' _sudo_toggle

