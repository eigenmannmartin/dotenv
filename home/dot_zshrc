typeset -ga DOTENV_PROJECT_PALETTE=(
  '#ed8796' '#f5a97f' '#eed49f' '#a6da95' '#8bd5ca' '#7dc4e4' '#8aadf4' '#c6a0f6' '#f5bde6' '#f0c6c6'
