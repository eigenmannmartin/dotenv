_src "$_zshare/zsh-autosuggestions/zsh-autosuggestions.zsh" "$HOME/.local/share/zsh-autosuggestions/zsh-autosuggestions.zsh" /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# fast-syntax-highlighting: command-line coloring — MUST be sourced last
