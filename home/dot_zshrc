# kitten ssh pushes kitty terminfo to remotes (fixes "unknown terminal xterm-kitty"), but only in a bare
# kitty shell. NOT inside tmux: the ssh kitten can't complete its handshake through tmux, so it dumps the
# KITTY_DATA blob / leaks escape codes into other panes. KITTY_WINDOW_ID is inherited into tmux, so also guard on $TMUX.
if command -v kitten >/dev/null 2>&1 && [[ -n "$KITTY_WINDOW_ID" && -z "$TMUX" ]]; then
  alias ssh='kitten ssh'
fi

# Auto-start tmux for interactive top-level shells; non-exec so a broken ~/.tmux.conf doesn't kill the login shell. Disable with TMUX_AUTOSTART=0.
if [[ -z "$TMUX" && -o interactive && -t 1 \
      && "${TMUX_AUTOSTART:-1}" != "0" \
      && "$TERM_PROGRAM" != "vscode" \
      && -z "$VSCODE_INJECTION$REMOTE_CONTAINERS$CODESPACES$CI$TERMINAL_EMULATOR" \
      && ! -e /.dockerenv && ! -e /run/.containerenv ]] \
   && command -v tmux >/dev/null; then
  tmux new-session -A -s main
fi
