# --- Modern CLI replacements (guarded: no-op if the tool isn't installed) --
# Colored `ls`: eza (icons + git) when installed, else native colored ls so
# `ls` is colored by default everywhere (GNU `--color`, or BSD `-G` on macOS).
if command -v eza >/dev/null; then
  alias ls='eza --icons --group-directories-first --color=auto'
  alias ll='eza -l  --icons --git --group-directories-first --color=auto'
  alias la='eza -la --icons --git --group-directories-first --color=auto'
  alias lt='eza --tree --level=2 --icons --color=auto'
elif ls --version >/dev/null 2>&1; then   # GNU coreutils
  alias ls='ls --color=auto'
  alias ll='ls -lh  --color=auto'
  alias la='ls -lAh --color=auto'
else                                        # BSD ls (default on macOS)
  export CLICOLOR=1
  alias ls='ls -G'
  alias ll='ls -lhG'
  alias la='ls -lAhG'
fi
# bat → cat with syntax highlighting. Debian/Ubuntu ship the binary as `batcat`.
# `--paging=never` keeps it cat-like; bat auto-drops decorations when piped.
if command -v bat >/dev/null; then
  export BAT_THEME="Catppuccin Macchiato"
  alias cat='bat --style=plain --paging=never'
elif command -v batcat >/dev/null; then
  export BAT_THEME="Catppuccin Macchiato"
  alias bat='batcat'
  alias cat='batcat --style=plain --paging=never'
fi

