# git worktree helper: gwt <branch> -> linked worktree in a sibling dir (+ cd into it)
gwt() {
  local top br dir
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { print -u2 "gwt: not in a git repo"; return 1; }
  br=${1:?usage: gwt <branch>}
  dir="${top}.${br//\//-}"
  [[ -d "$dir" ]] && { cd "$dir"; return; }
  if git show-ref --quiet "refs/heads/$br"; then git worktree add "$dir" "$br"
  else git worktree add -b "$br" "$dir"; fi && cd "$dir"
}
gwt-rm() {  # gwt-rm <branch>: remove the worktree created by gwt
  local main br=${1:?usage: gwt-rm <branch>}
  main=$(git worktree list --porcelain 2>/dev/null | awk 'NR==1{print $2}')
  [[ -n "$main" ]] && git worktree remove "${main}.${br//\//-}"
}

