unset _zshare
# atuin owns Ctrl-R (fzf --zsh also binds it, so rebind after)
command -v atuin >/dev/null && { bindkey '^r' atuin-search 2>/dev/null; bindkey -M viins '^r' atuin-search 2>/dev/null; }

# Tab: accept the greyed-out autosuggestion if one is showing; otherwise fall
# through to normal (fzf-tab) completion. Must be bound AFTER fzf-tab +
# zsh-autosuggestions load so both widgets exist.
_tab_accept_or_complete() {
  if [[ -n "$POSTDISPLAY" ]]; then
    zle autosuggest-accept
  elif zle -l fzf-tab-complete; then
    zle fzf-tab-complete
  else
    zle expand-or-complete
  fi
}
zle -N _tab_accept_or_complete
bindkey '^I' _tab_accept_or_complete
bindkey -M viins '^I' _tab_accept_or_complete

# Ctrl-C fix: with oh-my-posh transient_prompt enabled, the line-finish hook
# swallows the redraw on SIGINT, so Ctrl-C *looks* like it does nothing. This
# restores the clean abort + fresh prompt. Only affects the line editor —
# running foreground programs still get Ctrl-C from the tty.
TRAPINT() {
  zle && zle reset-prompt
  return $(( 128 + $1 ))
}

