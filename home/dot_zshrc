_dotenv_project_badge() {
  # Override with DOTENV_CODE_ROOT where projects don't live in ~/code (e.g. a VM
  # that clones somewhere else) — otherwise the badge silently never fires.
  local root="${DOTENV_CODE_ROOT:-$HOME/code}" proj=""
  [[ "$PWD/" == "$root"/* ]] && proj="${${PWD#$root/}%%/*}"
  if [[ -z "$proj" ]]; then
    unset DOTENV_PROJECT DOTENV_PROJECT_COLOR
    [[ -n "$TMUX" ]] && { tmux set -uw -t "$TMUX_PANE" @dotenv_project_color; tmux set -uw -t "$TMUX_PANE" @dotenv_project_initial } 2>/dev/null
    return
  fi
  export DOTENV_PROJECT="$proj"
  if [[ -n "${DOTENV_PROJECT_COLOR_MAP[$proj]}" ]]; then
    export DOTENV_PROJECT_COLOR="${DOTENV_PROJECT_COLOR_MAP[$proj]}"
  else
    local i c sum=0
    for (( i=1; i<=${#proj}; i++ )); do c=$proj[i]; sum=$(( (sum * 31 + #c) % 100000007 )); done
    export DOTENV_PROJECT_COLOR="${DOTENV_PROJECT_PALETTE[$(( sum % ${#DOTENV_PROJECT_PALETTE} + 1 ))]}"
  fi
  # Mirror project into tmux as WINDOW options (-w, keyed to this pane's window) so each window keeps
  # its own badge and switching windows re-resolves the color/initial against the active window.
  [[ -n "$TMUX" ]] && { tmux set -w -t "$TMUX_PANE" @dotenv_project_color "$DOTENV_PROJECT_COLOR"; tmux set -w -t "$TMUX_PANE" @dotenv_project_initial "${(U)proj[1,1]}" } 2>/dev/null
}
autoload -Uz add-zsh-hook
