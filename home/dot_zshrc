# --- oh-my-posh prompt (Catppuccin Macchiato + per-project badge) ---------
if command -v oh-my-posh >/dev/null; then
  _omp_cfg="$HOME/.config/oh-my-posh/config.omp.json"
  if [[ -r "$_omp_cfg" ]]; then
    eval "$(oh-my-posh init zsh --config "$_omp_cfg")"
  else
    eval "$(oh-my-posh init zsh)"
  fi
  unset _omp_cfg
fi

# --- per-project color badge (sets env vars the prompt segment reads) ------
# Folders under ~/code get a colored badge in the prompt: pinned colors first,
# otherwise a stable color auto-derived from the project name.
typeset -gA DOTENV_PROJECT_COLOR_MAP=(
  hsg        '#a6da95'   # green
  bechterew  '#8aadf4'   # blue
)
typeset -ga DOTENV_PROJECT_PALETTE=(
  '#ed8796' '#f5a97f' '#eed49f' '#a6da95' '#8bd5ca' '#7dc4e4' '#8aadf4' '#c6a0f6' '#f5bde6' '#f0c6c6'
)
_dotenv_project_badge() {
  local root="$HOME/code" proj=""
  [[ "$PWD/" == "$root"/* ]] && proj="${${PWD#$root/}%%/*}"
  if [[ -z "$proj" ]]; then
    unset DOTENV_PROJECT DOTENV_PROJECT_COLOR
    return
  fi
  export DOTENV_PROJECT="$proj"
  if [[ -n "${DOTENV_PROJECT_COLOR_MAP[$proj]}" ]]; then
    export DOTENV_PROJECT_COLOR="${DOTENV_PROJECT_COLOR_MAP[$proj]}"
  else
    local i c sum=0
    for (( i=1; i<=${#proj}; i++ )); do c=$proj[i]; sum=$(( (sum * 31 + #c) % 100000007 )); done
    export DOTENV_PROJECT_COLOR="${DOTENV_PROJECT_PALETTE[$(( sum % ${#DOTENV_PROJECT_PALETTE} + 1 ))]}"
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _dotenv_project_badge
_dotenv_project_badge

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/martin/.lmstudio/bin"
export PATH="$PATH:/Users/martin/flutter/bin"
# End of LM Studio CLI section

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/martin/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
export PATH=$PATH:/Users/martin/.runai/bin
[ -x /Users/martin/.runai/bin/runai ] && source <(/Users/martin/.runai/bin/runai completion zsh)

# --- 1Password SSH agent (host only) --------------------------------------
# Point SSH at the 1Password agent socket only when it exists, so that inside
# devcontainers/Codespaces the auto-forwarded SSH_AUTH_SOCK is left untouched.
_op_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
[ -S "$_op_sock" ] && export SSH_AUTH_SOCK="$_op_sock"
unset _op_sock

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# --- atuin: better shell history (local only — no server sync) ------------
command -v atuin >/dev/null && eval "$(atuin init zsh)"

# --- Auto-start tmux (interactive, top-level shells only) -----------------
# Skips when: already in tmux, non-interactive, no tty, VS Code / JetBrains
# terminals, devcontainers / Codespaces (Docker + Podman), or CI.
# Disable per-shell with TMUX_AUTOSTART=0.  Non-exec on purpose: if ~/.tmux.conf
# is broken the login shell still survives.
if [[ -z "$TMUX" && -o interactive && -t 1 \
      && "${TMUX_AUTOSTART:-1}" != "0" \
      && "$TERM_PROGRAM" != "vscode" \
      && -z "$VSCODE_INJECTION$REMOTE_CONTAINERS$CODESPACES$CI$TERMINAL_EMULATOR" \
      && ! -e /.dockerenv && ! -e /run/.containerenv ]] \
   && command -v tmux >/dev/null; then
  tmux new-session -A -s main
fi
