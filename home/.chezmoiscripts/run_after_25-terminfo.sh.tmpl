#!/usr/bin/env bash
# dotenv: guarantee this machine has a terminfo entry for the terminal you SSH in from.
#
# Why this exists: ssh forwards $TERM but not terminfo. Coming from kitty on macOS
# into a fresh Linux box, TERM=xterm-kitty resolves to nothing — and tmux does not
# degrade, it refuses to start ("missing or unsuitable terminal: xterm-kitty").
# It also leaves no `Ms` capability, so OSC 52 — the only way to reach the system
# clipboard over plain ssh — is unavailable. `kitten ssh` normally pushes terminfo for
# you, but `limactl shell`, plain `ssh` and VS Code remotes all bypass it.
#
# 20-install-packages already installs kitty-terminfo in its core apt batch; this is
# the retry. That batch is all-or-nothing and run_onchange_ (it only re-runs when its
# own text changes), so one bad first apply — the dpkg lock held by unattended-upgrades
# on a fresh cloud image, apt unreachable — would otherwise stick for good. chezmoi
# orders scripts by the STRIPPED target name (.chezmoiscripts/25-terminfo.sh), so the
# run_ prefix does not disturb the 20 -> 25 order.
#
# Where apt cannot help at all (no sudo, not Debian/Ubuntu) there is deliberately no
# further fallback: ~/.config/dotenv/term-guard.sh falls $TERM back to xterm-256color,
# which does resolve and whose terminfo has Ms, so tmux still starts AND still emits
# OSC 52. One mechanism, in the simpler place.
#
# run_after_, deliberately not run_onchange_: this asserts an invariant rather than
# performing a one-off install, and apt can fail transiently. run_onchange_ hashes the
# script, runs it once and never retries — one unlucky first apply would leave the box
# permanently without terminfo. When the entry is already there the whole script is a
# single infocmp, about 1 ms.
set -uo pipefail

{{ if eq .chezmoi.os "linux" -}}
ensure_terminfo() {  # <term-name>
  local t="$1" SUDO

  if infocmp -x "$t" >/dev/null 2>&1; then
    echo "==> terminfo '$t' already present"; return 0
  fi

  # Distro package — system-wide, so root/sudo shells get it too.
  if command -v apt-get >/dev/null 2>&1; then
    SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"
    if $SUDO apt-get install -y -qq kitty-terminfo 2>/dev/null \
       && infocmp -x "$t" >/dev/null 2>&1; then
      echo "==> installed '$t' terminfo from apt (kitty-terminfo)"; return 0
    fi
  fi

  echo "WARN: could not install terminfo for '$t' — falling back to term-guard.sh (TERM -> xterm-256color)"
  return 1
}

ensure_terminfo xterm-kitty

# The TERM guard has to reach BOTH shells. ~/.zshrc sources it directly (chezmoi
# manages that file); ~/.bashrc is NOT chezmoi-managed — it's Ubuntu's stock file,
# which other tools append to as well — so wire it in idempotently.
_guard="$HOME/.config/dotenv/term-guard.sh"
_mark="# dotenv: term-guard"
if [ -f "$HOME/.bashrc" ] && ! grep -qF "$_mark" "$HOME/.bashrc"; then
  printf '\n%s\n[ -r "%s" ] && . "%s"\n' "$_mark" "$_guard" "$_guard" >> "$HOME/.bashrc"
  echo "==> wired term-guard into ~/.bashrc"
fi
unset _guard _mark
{{ end -}}

echo "==> dotenv: terminfo step done"
