#!/usr/bin/env bash
# dotenv: install runtime packages on `chezmoi apply`; idempotent, self-gating in containers.
#
# Split into feature groups so a throwaway VM is not made to wait for a toolchain it
# will never use. Pick them per machine with DOTENV_FEATURES (see .chezmoidata.toml);
# `core` alone is just the shell, which is what most VMs actually need.
#
# The hash line below is load-bearing: run_onchange_ re-runs on a change to the
# script's RENDERED text, and a feature toggle that only flips template conditionals
# can leave the output byte-identical — so the script would silently never re-run.
# features hash: {{ .features | toJson | sha256sum }}
set -uo pipefail

{{- $dev := has "dev" .features }}
{{- $k8s := has "k8s" .features }}
{{- $vpn := has "vpn" .features }}
{{- $ai := has "ai" .features }}
{{- $docker := has "docker" .features }}

echo "==> dotenv: installing packages ({{ .chezmoi.os }}; features: {{ join "," .features }})"

have() { command -v "$1" >/dev/null 2>&1; }
is_container() {
  [ -e /.dockerenv ] || [ -e /run/.containerenv ] \
    || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ] \
    || [ -n "${container:-}" ]
}
# GUI payloads (kitty, fonts) are pointless without a display to render them on.
# "Is it a container" was the wrong question: a Lima/cloud VM is not a container,
# so it was downloading ~150 MB of kitty + Nerd Font into a headless box that can
# never use either — the glyphs are rendered by the terminal on YOUR machine.
is_headless() {
  is_container && return 0
  [ "$(uname -s)" = "Darwin" ] && return 1     # macOS always has a GUI
  [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]
}

# Fetch a binary out of a GitHub release tarball into ~/.local/bin.
# <owner/repo> <binary> <asset-template>
#   %V = version, %A = uname-style arch (x86_64|arm64), %G = Go-style arch (amd64|arm64)
# Projects disagree on the arch token — lazygit ships x86_64, k9s ships amd64 — and
# getting it wrong is invisible on arm64 (both use "arm64") while 404ing on every
# Intel box, so each caller states which spelling it needs.
gh_release_install() {
  local repo="$1" bin="$2" tmpl="$3" ver arch goarch tmp asset
  have "$bin" && return 0
  echo "==> installing $bin"
  ver="$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" \
    | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$ver" ] || { echo "WARN: could not resolve $bin version"; return 0; }
  case "$(uname -m)" in
    x86_64|amd64)  arch=x86_64; goarch=amd64 ;;
    aarch64|arm64) arch=arm64;  goarch=arm64 ;;
    *)             arch="$(uname -m)"; goarch="$arch" ;;
  esac
  asset="${tmpl//%V/$ver}"; asset="${asset//%A/$arch}"; asset="${asset//%G/$goarch}"
  tmp="$(mktemp -d)"
  if curl -fLso "$tmp/a.tgz" "https://github.com/$repo/releases/download/v${ver}/${asset}"; then
    tar -xzf "$tmp/a.tgz" -C "$tmp" "$bin" 2>/dev/null \
      && install -m755 "$tmp/$bin" "$HOME/.local/bin/$bin" \
      || echo "WARN: $bin not found in archive"
  else
    echo "WARN: $bin download failed"
  fi
  rm -rf "$tmp"
}

# Global npm CLIs (devcontainer, claude, codex). Defined unconditionally because more
# than one feature needs it.
npm_global_install() {   # <package> [min-node-major]
  have "$2" && return 0
  # Loud, and says what to do: this silently swallowed every npm install on a fresh
  # Ubuntu VM, because `nodejs` there ships without npm.
  have npm || { echo "WARN: npm not installed — skipping $1. Fix with: sudo apt-get install -y npm" >&2; return 0; }
  if [ -n "${3:-}" ]; then
    _nodemaj="$(node -v 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/')"
    if [ -n "$_nodemaj" ] && [ "$_nodemaj" -lt "$3" ]; then
      echo "WARN: $1 needs node >= $3, this box has $(node -v) — skipping" >&2
      return 0
    fi
  fi
  echo "==> installing $2"
  if ! npm install -g "$1" >/dev/null 2>&1; then
    # A distro node puts its global prefix under /usr, which needs root. Rather than
    # sudo-installing into system paths, point npm at ~/.local — already on PATH, and
    # it keeps every global CLI in a directory this user owns.
    npm config set prefix "$HOME/.local" >/dev/null 2>&1
    npm install -g "$1" >/dev/null 2>&1 || echo "WARN: $2 install failed (npm -g $1)"
  fi
}

{{ if eq .chezmoi.os "darwin" -}}
if have brew; then
  # --no-upgrade: install only what's missing; don't churn already-installed tools.
  # Brewfile.<feature> files are additive; a missing one is simply skipped.
  for _bf in Brewfile {{ if $dev }}Brewfile.dev{{ end }} {{ if $k8s }}Brewfile.k8s{{ end }}; do
    _p="{{ .chezmoi.workingTree }}/$_bf"
    [ -f "$_p" ] || continue
    brew bundle --no-upgrade --file "$_p" || echo "WARN: brew bundle ($_bf) had failures"
  done
  unset _bf _p

  # Prune broken zsh completion symlinks (Docker cask rename orphaned _docker links) so compinit doesn't error; -L follows links so only dead ones match.
  _bsf="$(brew --prefix 2>/dev/null)/share/zsh/site-functions"
  if [ -d "$_bsf" ]; then
    find -L "$_bsf" -maxdepth 1 -type l -delete 2>/dev/null \
      && echo "==> pruned broken zsh completion symlinks in $_bsf"
  fi
  unset _bsf
else
  echo "WARN: Homebrew not found — install from https://brew.sh and re-run 'chezmoi apply'."
fi

{{ else if eq .chezmoi.os "linux" -}}
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"

if have apt-get; then
  $SUDO apt-get update -qq || true
  # DEBIAN_FRONTEND via `env`, not `export`: sudo's env_reset strips exported vars,
  # so the export form never reaches apt/dpkg/needrestart under sudo.
  apt_install() { $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@"; }

  # core — the shell itself. kitty-terminfo + ncurses-term: ssh forwards $TERM but
  # not terminfo. Without an xterm-kitty entry, tmux refuses to start outright and
  # OSC 52 (clipboard over ssh) is unavailable. See 25-terminfo for the fallbacks.
  apt_install zsh tmux git curl unzip ca-certificates fontconfig \
    ripgrep fzf bat kitty-terminfo ncurses-term \
    || echo "WARN: some core apt packages failed to install"

{{ if $dev }}
  # dev — editor + language runtimes. Biggest single chunk of a full install, and
  # dead weight on a VM you only ssh into to run one service.
  #
  # npm is listed EXPLICITLY: Debian/Ubuntu split it out of the nodejs package, so
  # `nodejs` alone gives you `node` and no `npm`. Everything installed through npm
  # below (devcontainer, claude, codex) then silently skipped with a warning that
  # scrolled past during provisioning.
  apt_install neovim python3 nodejs npm jq btop direnv \
    || echo "WARN: some dev apt packages failed to install"
{{ end }}
{{ if $vpn }}
  # vpn — see ~/.local/bin/cisco-vpn. openconnect >= 9.00 (Ubuntu 24.04+ / Debian 12+)
  # is what supports SSO; vpnc-scripts owns the route/DNS setup.
  apt_install openconnect vpnc-scripts pipx \
    || echo "WARN: vpn apt packages failed to install"
  have openconnect-saml || pipx install openconnect-saml >/dev/null 2>&1 \
    || echo "WARN: openconnect-saml install failed (needed for embedded-SAML head-ends)"
{{ end }}
{{ if $docker }}
  # docker — a container runtime *inside* the VM, so devcontainers (and `dx`) run here
  # rather than against OrbStack on the Mac. The devcontainer CLI shells out to the
  # `docker` binary specifically, which is why this is docker.io and not containerd.
  apt_install docker.io docker-compose-v2 \
    || echo "WARN: docker apt packages failed to install"
  if have docker && ! id -nG "$(id -un)" | grep -qw docker; then
    $SUDO usermod -aG docker "$(id -un)" \
      && echo "==> added $(id -un) to the docker group — log out and back in for it to apply"
  fi
  $SUDO systemctl enable --now docker >/dev/null 2>&1 || true
{{ end }}

  # Install these separately so a per-tool miss can't block the batch above.
  if ! have eza; then
    apt_install eza 2>/dev/null \
      || echo "WARN: eza not in apt (Ubuntu 24.04+ only) — see https://eza.rocks"
  fi
  have zoxide || apt_install zoxide 2>/dev/null \
    || echo "WARN: zoxide not in apt (24.04+) — see https://github.com/ajeetdsouza/zoxide"
  have delta  || apt_install git-delta 2>/dev/null \
    || echo "WARN: git-delta not in apt — see https://dandavison.github.io/delta"
  # fd: apt package fd-find ships binary fdfind — zshrc aliases fd=fdfind.
  have fd || have fdfind || apt_install fd-find 2>/dev/null \
    || echo "WARN: fd-find not in apt — see https://github.com/sharkdp/fd"
else
  echo "WARN: apt-get not found; this installer targets Debian/Ubuntu."
fi

# atuin — not reliably packaged in apt; official installer (-> ~/.local/bin)
if ! have atuin; then
  echo "==> installing atuin"
  curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh || echo "WARN: atuin install failed"
fi

if ! have oh-my-posh; then
  echo "==> installing oh-my-posh"
  mkdir -p "$HOME/.local/bin"
  curl -s https://ohmyposh.dev/install.sh | bash -s -- -d "$HOME/.local/bin" \
    || echo "WARN: oh-my-posh install failed"
fi

{{ if $dev }}
mkdir -p "$HOME/.local/bin"
gh_release_install jesseduffield/lazygit lazygit 'lazygit_%V_Linux_%A.tar.gz'
{{ end }}
{{ if $k8s }}
mkdir -p "$HOME/.local/bin"
gh_release_install derailed/k9s k9s 'k9s_Linux_%G.tar.gz'
{{ end }}

# Desktop-only: kitty + FiraCode Nerd Font. Skipped anywhere without a display —
# containers AND headless VMs. When you ssh in from kitty on a Mac, the font and the
# terminal both live on the Mac; the remote only ever needs the terminfo entry.
if is_headless; then
  echo "==> headless (no display): skipping kitty + fonts — terminfo is all a remote needs"
else
  if ! have kitty; then
    echo "==> installing kitty"
    curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin launch=n \
      || echo "WARN: kitty install failed"
  fi
  if ! fc-list 2>/dev/null | grep -qi "FiraCode Nerd Font"; then
    echo "==> installing FiraCode Nerd Font"
    FONT_DIR="$HOME/.local/share/fonts"; mkdir -p "$FONT_DIR"
    tmpzip="$(mktemp)"
    if curl -fLso "$tmpzip" \
        https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip; then
      unzip -oq "$tmpzip" -d "$FONT_DIR" && fc-cache -f "$FONT_DIR" >/dev/null 2>&1
    else
      echo "WARN: FiraCode Nerd Font download failed"
    fi
    rm -f "$tmpzip"
  fi
fi

{{ else -}}
echo "WARN: unsupported OS '{{ .chezmoi.os }}' — install tmux/atuin/oh-my-posh manually."
{{ end -}}

# Shell plugins not in package managers: clone to ~/.local/share
clone_plugin() {  # <repo-url> <dir-name>
  local d="$HOME/.local/share/$2"
  [ -d "$d" ] || git clone --depth 1 "$1" "$d" 2>/dev/null || echo "WARN: clone $2 failed"
}
clone_plugin https://github.com/Aloxaf/fzf-tab fzf-tab
{{ if eq .chezmoi.os "linux" -}}
# On macOS these come from Homebrew; on Linux clone them (apt's are older/absent).
clone_plugin https://github.com/zsh-users/zsh-autosuggestions zsh-autosuggestions
clone_plugin https://github.com/zdharma-continuum/fast-syntax-highlighting zsh-fast-syntax-highlighting
{{ end -}}

if have delta && have git; then
  git config --global core.pager "delta"
  git config --global interactive.diffFilter "delta --color-only"
  git config --global delta.navigate true
  git config --global delta.line-numbers true
  git config --global delta.dark true
  git config --global delta.syntax-theme "Catppuccin Macchiato"
  git config --global merge.conflictStyle zdiff3
fi

{{ if $k8s }}
# k9s config.yaml is k9s-managed (rewritten on exit), so patch only our preference keys in place once it exists; yq preferred, python fallback.
# enableMouse=false on purpose: with it on, k9s grabs the mouse and its reactive refresh wipes any selection — you can't copy.
# Off, a drag falls through to tmux copy-mode (a frozen snapshot tmux-yank copies cleanly); read/copy structured output via the Shift-D/Y/X/E pager plugins.
if have k9s; then
  _k9s_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/k9s/config.yaml"
  if [ -f "$_k9s_cfg" ] && have yq; then
    yq -i '
      .k9s.ui.skin = "catppuccin-macchiato" |
      .k9s.ui.reactive = true |
      .k9s.ui.enableMouse = false |
      .k9s.liveViewAutoRefresh = true |
      .k9s.skipLatestRevCheck = true |
      .k9s.maxConnRetry = 15 |
      .k9s.shellPod.image = "nicolaka/netshoot:latest" |
      .k9s.logger.tail = 5000 |
      .k9s.logger.buffer = 50000 |
      .k9s.logger.textWrap = true |
      .k9s.logger.showTime = true
    ' "$_k9s_cfg" 2>/dev/null \
      && echo "==> patched k9s config.yaml (skin + reactive UI + logger + netshoot shellPod)" \
      || echo "WARN: k9s config.yaml patch (yq) failed"
  elif [ -f "$_k9s_cfg" ]; then
    python3 - "$_k9s_cfg" <<'PY' 2>/dev/null || true
import sys, re
p = sys.argv[1]; s = open(p).read()
def setk(block, key, val, s):
    if re.search(rf'^    {key}:', s, re.M):
        return re.sub(rf'^    {key}:.*$', f'    {key}: {val}', s, count=1, flags=re.M)
    if re.search(rf'^  {block}:\s*$', s, re.M):
        return re.sub(rf'^  {block}:\s*$', f'  {block}:\n    {key}: {val}', s, count=1, flags=re.M)
    return s
if 'skin:' not in s:
    s = setk('ui', 'skin', 'catppuccin-macchiato', s)
s = setk('logger', 'tail', '5000', s)
s = setk('logger', 'buffer', '50000', s)
s = setk('logger', 'textWrap', 'true', s)
open(p, 'w').write(s)
PY
  fi
fi
{{ end }}

{{ if $dev }}
if have gh; then
  gh extension list 2>/dev/null | grep -q 'dlvhdr/gh-dash' \
    || gh extension install dlvhdr/gh-dash >/dev/null 2>&1 || true
fi

npm_global_install @devcontainers/cli devcontainer
{{ end }}

{{ if $ai }}
# ai — coding agents. Both ship on npm with zero dependencies and self-update
# afterwards, so this only has to bootstrap them. `claude` and `codex` authenticate
# per machine; the credentials are shared between VMs by dotenv-persist.
# The node floors come from each package's own "engines" field.
npm_global_install @anthropic-ai/claude-code claude 22
npm_global_install @openai/codex codex 16
{{ end }}

{{ if eq .chezmoi.os "linux" -}}
# This repo is zsh-only (~10 KB of ~/.zshrc: prompt, aliases, fzf-tab, tmux autostart).
# On a box where the login shell is still bash — the default for a fresh Lima/cloud VM —
# ALL of it is inert, and nothing says so, which is easy to miss over ssh.
# macOS already defaults to zsh, so this is Linux-only. Opt out with DOTENV_NO_CHSH=1.
if [ "${DOTENV_NO_CHSH:-0}" != "1" ] && have zsh; then
  _SUDO=""; [ "$(id -u)" -ne 0 ] && _SUDO="sudo"
  _zsh="$(command -v zsh)"
  _cur="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)"
  if [ -n "$_cur" ] && [ "$_cur" != "$_zsh" ]; then
    grep -qxF "$_zsh" /etc/shells 2>/dev/null || echo "$_zsh" | $_SUDO tee -a /etc/shells >/dev/null
    # chsh prompts for a password under PAM; sudo works unattended where it's passwordless.
    if $_SUDO chsh -s "$_zsh" "$(id -un)" 2>/dev/null || chsh -s "$_zsh" 2>/dev/null; then
      echo "==> login shell -> $_zsh (was $_cur); takes effect on your next login"
    else
      echo "WARN: could not change login shell — run: chsh -s $_zsh"
    fi
  fi
  unset _SUDO _zsh _cur
fi
{{ end -}}

echo "==> dotenv: package step done"
