#!/usr/bin/env bash
# dotenv: install runtime dependencies. Runs on `chezmoi apply` whenever this
# script changes. Idempotent and self-gating (skips GUI bits in containers).
set -uo pipefail

echo "==> dotenv: installing packages ({{ .chezmoi.os }})"

have() { command -v "$1" >/dev/null 2>&1; }
is_container() {
  [ -e /.dockerenv ] || [ -e /run/.containerenv ] \
    || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ] \
    || [ -n "${container:-}" ]
}

{{ if eq .chezmoi.os "darwin" -}}
# ----------------------------- macOS (Homebrew) ---------------------------
if have brew; then
  # --no-upgrade: install only what's missing; don't churn already-installed tools.
  brew bundle --no-upgrade --file "{{ .chezmoi.workingTree }}/Brewfile" || echo "WARN: brew bundle had failures"

  # Prune broken zsh completion symlinks in Homebrew's site-functions dir. The
  # Docker Desktop cask rename (docker -> docker-desktop) orphaned _docker and
  # _docker-compose links pointing into a Caskroom path that no longer exists,
  # which makes `compinit` error on every shell start. `find -L ... -type l`
  # matches only symlinks whose target is missing (because -L follows the link),
  # so this removes dead links and never the valid ones. docker completion is
  # preserved: a real ~/.docker/completions/_docker is first on fpath (zshrc).
  _bsf="$(brew --prefix 2>/dev/null)/share/zsh/site-functions"
  if [ -d "$_bsf" ]; then
    find -L "$_bsf" -maxdepth 1 -type l -delete 2>/dev/null \
      && echo "==> pruned broken zsh completion symlinks in $_bsf"
  fi
  unset _bsf
else
  echo "WARN: Homebrew not found — install from https://brew.sh and re-run 'chezmoi apply'."
fi

{{ else if eq .chezmoi.os "linux" -}}
# --------------------------- Linux (Debian/Ubuntu) ------------------------
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"

if have apt-get; then
  export DEBIAN_FRONTEND=noninteractive
  $SUDO apt-get update -qq || true
  $SUDO apt-get install -y -qq \
    zsh tmux git curl unzip ca-certificates fontconfig ripgrep fzf bat neovim \
    python3 direnv nodejs jq btop \
    || echo "WARN: some apt packages failed to install"
  # gh/yq/mise/kubecolor/git-absorb/dust/duf/procs vary by release — install via
  # Homebrew-on-Linux or their upstream releases (macOS gets them from the Brewfile).

  # eza (modern ls) is only packaged in newer apt (Ubuntu 24.04+); install it
  # on its own so its absence can't block the batch above.
  if ! have eza; then
    $SUDO apt-get install -y -qq eza 2>/dev/null \
      || echo "WARN: eza not in apt (Ubuntu 24.04+ only) — see https://eza.rocks"
  fi
  # zoxide (24.04+) and git-delta on their own so a miss can't block the batch.
  have zoxide || $SUDO apt-get install -y -qq zoxide 2>/dev/null \
    || echo "WARN: zoxide not in apt (24.04+) — see https://github.com/ajeetdsouza/zoxide"
  have delta  || $SUDO apt-get install -y -qq git-delta 2>/dev/null \
    || echo "WARN: git-delta not in apt — see https://dandavison.github.io/delta"
  # fd (apt package fd-find; binary fdfind — zshrc aliases fd=fdfind).
  have fd || have fdfind || $SUDO apt-get install -y -qq fd-find 2>/dev/null \
    || echo "WARN: fd-find not in apt — see https://github.com/sharkdp/fd"
else
  echo "WARN: apt-get not found; this installer targets Debian/Ubuntu."
fi

# atuin — not reliably packaged in apt; use the official installer (-> ~/.local/bin)
if ! have atuin; then
  echo "==> installing atuin"
  curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh || echo "WARN: atuin install failed"
fi

# oh-my-posh — official installer (-> ~/.local/bin)
if ! have oh-my-posh; then
  echo "==> installing oh-my-posh"
  mkdir -p "$HOME/.local/bin"
  curl -s https://ohmyposh.dev/install.sh | bash -s -- -d "$HOME/.local/bin" \
    || echo "WARN: oh-my-posh install failed"
fi

# lazygit — not in apt; pull the latest GitHub release tarball (-> ~/.local/bin)
if ! have lazygit; then
  echo "==> installing lazygit"
  LG_VER="$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest \
    | grep -oP '"tag_name": *"v\K[^"]+' || true)"
  if [ -n "$LG_VER" ]; then
    case "$(uname -m)" in x86_64) a=x86_64;; aarch64|arm64) a=arm64;; *) a="$(uname -m)";; esac
    tmp="$(mktemp -d)"
    if curl -fLso "$tmp/lg.tgz" \
        "https://github.com/jesseduffield/lazygit/releases/download/v${LG_VER}/lazygit_${LG_VER}_Linux_${a}.tar.gz"; then
      tar -xzf "$tmp/lg.tgz" -C "$tmp" lazygit \
        && install -m755 "$tmp/lazygit" "$HOME/.local/bin/lazygit"
    else echo "WARN: lazygit download failed"; fi
    rm -rf "$tmp"
  else echo "WARN: could not resolve lazygit version"; fi
fi

# Desktop-only (skipped in containers): kitty + FiraCode Nerd Font
if is_container; then
  echo "==> container detected: skipping kitty + fonts (host-only)"
else
  if ! have kitty; then
    echo "==> installing kitty"
    curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin launch=n \
      || echo "WARN: kitty install failed"
  fi
  if ! fc-list 2>/dev/null | grep -qi "FiraCode Nerd Font"; then
    echo "==> installing FiraCode Nerd Font"
    FONT_DIR="$HOME/.local/share/fonts"; mkdir -p "$FONT_DIR"
    tmpzip="$(mktemp)"
    if curl -fLso "$tmpzip" \
        https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip; then
      unzip -oq "$tmpzip" -d "$FONT_DIR" && fc-cache -f "$FONT_DIR" >/dev/null 2>&1
    else
      echo "WARN: FiraCode Nerd Font download failed"
    fi
    rm -f "$tmpzip"
  fi
fi

{{ else -}}
echo "WARN: unsupported OS '{{ .chezmoi.os }}' — install tmux/atuin/oh-my-posh manually."
{{ end -}}

# --- Shell plugins not in package managers: clone to ~/.local/share -------
clone_plugin() {  # <repo-url> <dir-name>
  local d="$HOME/.local/share/$2"
  [ -d "$d" ] || git clone --depth 1 "$1" "$d" 2>/dev/null || echo "WARN: clone $2 failed"
}
clone_plugin https://github.com/Aloxaf/fzf-tab fzf-tab
{{ if eq .chezmoi.os "linux" -}}
# On macOS these come from Homebrew; on Linux clone them (apt's are older/absent).
clone_plugin https://github.com/zsh-users/zsh-autosuggestions zsh-autosuggestions
clone_plugin https://github.com/zdharma-continuum/fast-syntax-highlighting zsh-fast-syntax-highlighting
{{ end -}}

# --- git-delta as the git pager (idempotent; only if delta + git present) -
if have delta && have git; then
  git config --global core.pager "delta"
  git config --global interactive.diffFilter "delta --color-only"
  git config --global delta.navigate true
  git config --global delta.line-numbers true
  git config --global delta.dark true
  git config --global delta.syntax-theme "Catppuccin Macchiato"
  git config --global merge.conflictStyle zdiff3
fi

# k9s: ship the (blue-accented) Catppuccin Macchiato skin via ~/.config/k9s/skins
# and patch our prefs — blue skin + full logs — into k9s's own config once it has
# written one. config.yaml is k9s-managed (+ machine paths) so we patch in place,
# idempotently, rather than tracking it. No-op if k9s/config is absent.
if have k9s; then
  _k9s_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/k9s/config.yaml"
  [ -f "$_k9s_cfg" ] && python3 - "$_k9s_cfg" <<'PY' 2>/dev/null || true
import sys, re
p = sys.argv[1]; s = open(p).read()
def setk(block, key, val, s):
    if re.search(rf'^    {key}:', s, re.M):
        return re.sub(rf'^    {key}:.*$', f'    {key}: {val}', s, count=1, flags=re.M)
    if re.search(rf'^  {block}:\s*$', s, re.M):
        return re.sub(rf'^  {block}:\s*$', f'  {block}:\n    {key}: {val}', s, count=1, flags=re.M)
    return s
if 'skin:' not in s:
    s = setk('ui', 'skin', 'catppuccin-macchiato', s)
s = setk('logger', 'tail', '5000', s)
s = setk('logger', 'buffer', '50000', s)
s = setk('logger', 'textWrap', 'true', s)
open(p, 'w').write(s)
PY
fi

# gh-dash: install the GitHub dashboard extension (idempotent; needs gh, no auth).
if have gh; then
  gh extension list 2>/dev/null | grep -q 'dlvhdr/gh-dash' \
    || gh extension install dlvhdr/gh-dash >/dev/null 2>&1 || true
fi

# Dev Containers CLI (build / up / exec devcontainers from the terminal). npm global;
# needs node (Brewfile / apt nodejs). Tolerant — Linux may need a writable npm prefix.
if have npm && ! have devcontainer; then
  npm install -g @devcontainers/cli >/dev/null 2>&1 \
    || echo "WARN: devcontainer CLI install failed (npm -g; set a user npm prefix on Linux)"
fi

echo "==> dotenv: package step done"
