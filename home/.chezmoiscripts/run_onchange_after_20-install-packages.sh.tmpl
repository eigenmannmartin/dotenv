#!/usr/bin/env bash
# dotenv: install runtime packages on `chezmoi apply`; idempotent, safe to re-run.
#
# Split into feature groups so a throwaway VM is not made to wait for a toolchain it
# will never use. Pick them per machine with DOTENV_FEATURES (see .chezmoidata.toml);
# `core` alone is just the shell, which is what most VMs actually need, and `devlite`
# is the editor/toolchain without the container half (which is what `dev` adds).
#
# Shell and tmux plugins are NOT installed here: chezmoi clones them itself, on every
# OS, from home/.chezmoiexternal.toml.
#
# The hash line below is load-bearing: run_onchange_ re-runs on a change to the
# script's RENDERED text, and a feature toggle that only flips template conditionals
# can leave the output byte-identical — so the script would silently never re-run.
# features hash: {{ .features | toJson | sha256sum }}
set -uo pipefail

{{- $dev := has "dev" .features }}
{{/* "dev" is "devlite" plus the container layer, so it implies it everywhere. Anything
     that is not a container tool belongs behind $devlite, or asking for the heavier
     feature would be the only way to get an editor. */}}
{{- $devlite := or (has "devlite" .features) $dev }}
{{- $k8s := has "k8s" .features }}
{{- $vpn := has "vpn" .features }}
{{- $ai := has "ai" .features }}
{{- $docker := has "docker" .features }}
{{/* flutter installs nothing on Linux, deliberately: Xcode and the simulators exist
     only on macOS, and a Lima VM drives them over ssh (see Brewfile.flutter) rather
     than re-downloading a ~1.5 GB SDK into every throwaway box. */}}
{{- $flutter := has "flutter" .features }}

echo "==> dotenv: installing packages ({{ .chezmoi.os }}; features: {{ join "," .features }})"

have() { command -v "$1" >/dev/null 2>&1; }

# Everything below installs into ~/.local/bin, and chezmoi runs this under bash with
# whatever PATH it was started with — on a fresh VM often one without ~/.local/bin,
# which only .zshenv adds. Then every `have` test here missed what an earlier apply
# had installed (re-downloading it each time), and a check like `fzf --zsh` would
# keep asking an old /usr/bin copy. Same order as .zshenv: ~/.local/bin first.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# install_bin <bin> <url> [<tree-dir>]
# The one way a release binary gets onto this machine: download <url>, put <bin> into
# ~/.local/bin. Callers do their own "already installed?" test first (`have x ||`, or
# a version/feature check where an old copy may be on PATH) — partly because some
# URLs carry a version lookup that is itself a network call.
#
#   <url> may contain %A = uname-style arch (x86_64|arm64), %G = Go-style arch
#   (amd64|arm64), %R = Rust-triple arch (x86_64|aarch64). Projects disagree on the
#   arch token — lazygit ships x86_64, yq ships amd64, atuin ships aarch64 — and
#   getting it wrong is invisible on one arch (uname and Go agree on "arm64", uname
#   and Rust on "x86_64") while 404ing on the other, so each caller states which
#   spelling it needs.
#   .tar.gz/.tgz and .tar.xz are unpacked and <bin> is taken from wherever it sits
#   inside (top level, a versioned directory, linux-amd64/); any other URL is the
#   bare binary itself.
#   <tree-dir> keeps the WHOLE unpacked tree there instead (replacing the previous
#   one; an archive's single top-level directory becomes <tree-dir> itself) and
#   symlinks ~/.local/bin/<bin> into it — for releases whose binary needs its runtime
#   files beside it (Neovim).
#
# Staged in a temp dir, so a failed or truncated download never lands on PATH, where
# the caller's `have` test would then skip re-installing it. Never fatal: a miss is a
# WARN, and the next time this run_onchange_ script runs (its text or the feature set
# changes) retries it.
install_bin() {
  local bin="$1" url="$2" tree="${3:-}" arch goarch rustarch tmp src root
  case "$(uname -m)" in
    x86_64|amd64)  arch=x86_64; goarch=amd64; rustarch=x86_64 ;;
    aarch64|arm64) arch=arm64;  goarch=arm64; rustarch=aarch64 ;;
    *)             arch="$(uname -m)"; goarch="$arch"; rustarch="$arch" ;;
  esac
  url="${url//%A/$arch}"; url="${url//%G/$goarch}"; url="${url//%R/$rustarch}"
  echo "==> installing $bin"
  mkdir -p "$HOME/.local/bin"
  tmp="$(mktemp -d)"
  if ! curl -fLso "$tmp/dl" "$url"; then
    echo "WARN: $bin download failed ($url)"; rm -rf "$tmp"; return 0
  fi
  mkdir "$tmp/x"
  case "$url" in
    *.tar.gz|*.tgz) tar -xzf "$tmp/dl" -C "$tmp/x" ;;
    *.tar.xz)       tar -xJf "$tmp/dl" -C "$tmp/x" ;;
    *)              mv "$tmp/dl" "$tmp/x/$bin" && chmod 755 "$tmp/x/$bin" ;;
  esac
  src="$(find "$tmp/x" -type f -name "$bin" -perm -100 2>/dev/null | head -n 1)"
  if [ -z "$src" ]; then
    echo "WARN: no executable '$bin' in $url"
  elif [ -z "$tree" ]; then
    # rm first: install(1) would write THROUGH a symlink left there by an older
    # installer instead of replacing it.
    rm -f "$HOME/.local/bin/$bin"
    install -m755 "$src" "$HOME/.local/bin/$bin" || echo "WARN: $bin install failed"
  else
    root="$tmp/x"; set -- "$tmp"/x/*
    [ $# -eq 1 ] && [ -d "$1" ] && root="$1"
    # Via <tree-dir>.new, so a copy that dies half-way (mv from /tmp is a copy) never
    # replaces a working tree.
    rm -rf "$tree.new" && mkdir -p "${tree%/*}" && mv "$root" "$tree.new" \
      && rm -rf "$tree" && mv "$tree.new" "$tree" \
      && ln -sfn "$tree/${src#"$root"/}" "$HOME/.local/bin/$bin" \
      || echo "WARN: $bin install into $tree failed"
  fi
  rm -rf "$tmp"
}

# gh_release_install <owner/repo> <bin> <asset-template> [<tree-dir>]
# install_bin for a GitHub release asset; the template takes install_bin's arch
# tokens plus %V = version.
#
# Everything goes through releases/latest/download/, a plain redirect to
# releases/download/<tag>/, and never through api.github.com: that API allows 60
# unauthenticated requests/hour per IP, every Lima VM shares the Mac's public IP, and
# a run_onchange_ script that misses a tool does not run again until its text changes.
# An unversioned asset name is downloaded through the redirect directly. For %V, the
# tag is read from where the redirect points (without following it), and %V is that
# tag minus a leading "v".
gh_release_install() {
  local repo="$1" bin="$2" asset="$3" tag
  if [ "${asset#*%V}" != "$asset" ]; then
    tag="$(curl -fsS -o /dev/null -w '%{redirect_url}' "https://github.com/$repo/releases/latest/download/x" \
      | sed -n 's#.*/releases/download/\([^/]*\)/x$#\1#p')"
    [ -n "$tag" ] || { echo "WARN: could not resolve $bin version"; return 0; }
    install_bin "$bin" "https://github.com/$repo/releases/download/${tag}/${asset//%V/${tag#v}}" "${4:-}"
  else
    install_bin "$bin" "https://github.com/$repo/releases/latest/download/${asset}" "${4:-}"
  fi
}

# Global npm CLIs (pnpm, prettier, claude, codex, backlog). Defined unconditionally
# because more than one feature needs it.
npm_global_install() {   # <package> <binary> [min-node-major]
  have "$2" && return 0
  # Loud, and says what to do: this silently swallowed every npm install on a fresh
  # Ubuntu VM, because `nodejs` there ships without npm.
  have npm || { echo "WARN: npm not installed — skipping $1. Fix with: sudo apt-get install -y npm" >&2; return 0; }
  if [ -n "${3:-}" ]; then
    _nodemaj="$(node -v 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/')"
    if [ -n "$_nodemaj" ] && [ "$_nodemaj" -lt "$3" ]; then
      echo "WARN: $1 needs node >= $3, this box has $(node -v) — skipping" >&2
      return 0
    fi
  fi
  echo "==> installing $2"
  if ! npm install -g "$1" >/dev/null 2>&1; then
    # A distro node puts its global prefix under /usr, which needs root. Rather than
    # sudo-installing into system paths, point npm at ~/.local — already on PATH, and
    # it keeps every global CLI in a directory this user owns.
    npm config set prefix "$HOME/.local" >/dev/null 2>&1
    npm install -g "$1" >/dev/null 2>&1 || echo "WARN: $2 install failed (npm -g $1)"
  fi
}

{{ if eq .chezmoi.os "darwin" -}}
if have brew; then
  # --no-upgrade: install only what's missing; don't churn already-installed tools.
  # Brewfile.<feature> files are additive; a missing one is simply skipped.
  for _bf in Brewfile {{ if $devlite }}Brewfile.devlite{{ end }} {{ if $dev }}Brewfile.dev{{ end }} {{ if $k8s }}Brewfile.k8s{{ end }} {{ if $flutter }}Brewfile.flutter{{ end }}; do
    _p="{{ .chezmoi.sourceDir | dir }}/$_bf"
    [ -f "$_p" ] || continue
    brew bundle --no-upgrade --file "$_p" || echo "WARN: brew bundle ($_bf) had failures"
  done
  unset _bf _p
else
  echo "WARN: Homebrew not found — install from https://brew.sh and re-run 'chezmoi apply'."
fi

{{ else if eq .chezmoi.os "linux" -}}
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"

if have apt-get; then
  $SUDO apt-get update -qq || true
  # DEBIAN_FRONTEND via `env`, not `export`: sudo's env_reset strips exported vars,
  # so the export form never reaches apt/dpkg/needrestart under sudo.
  apt_install() { $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@"; }

  # core — the shell itself. kitty-terminfo + ncurses-term: ssh forwards $TERM but
  # not terminfo. Without an xterm-kitty entry, tmux refuses to start outright and
  # OSC 52 (clipboard over ssh) is unavailable; 25-terminfo retries it on every apply.
  # fzf is deliberately NOT here (see the release binaries below). unzip: Mason
  # (LazyVim's LSP installer) unpacks most servers with it.
  apt_install zsh tmux git curl unzip ca-certificates \
    ripgrep bat kitty-terminfo ncurses-term \
    || echo "WARN: some core apt packages failed to install"

{{ if $devlite }}
  # devlite — editor + language runtimes. Biggest single chunk of a full install, and
  # dead weight on a VM you only ssh into to run one service.
  #
  # npm is listed EXPLICITLY: Debian/Ubuntu split it out of the nodejs package, so
  # `nodejs` alone gives you `node` and no `npm`. Everything installed through npm
  # below (pnpm, prettier, claude, codex) then silently skipped with a warning that
  # scrolled past during provisioning.
  # gh: Ubuntu's universe build is fine for PR/issue work; the login persists across
  # VMs via dotenv-persist (.config/gh/hosts.yml).
  # build-essential: a C compiler, which nvim-treesitter needs to build its parsers.
  # Neovim itself is NOT here: apt's is too old for LazyVim (see below).
  apt_install python3 nodejs npm jq btop direnv gh pipx git-lfs build-essential \
    || echo "WARN: some dev apt packages failed to install"
  # pre-commit via pipx, not apt: hook repos routinely demand a minimum pre-commit
  # version newer than the distro package.
  have pre-commit || pipx install pre-commit >/dev/null 2>&1 \
    || echo "WARN: pre-commit install failed (pipx)"
{{ end }}
{{ if $vpn }}
  # vpn — see ~/.local/bin/cisco-vpn. openconnect >= 9.00 (Ubuntu 24.04+ / Debian 12+)
  # is what supports SSO; vpnc-scripts owns the route/DNS setup. bind9-dnsutils is
  # dig, which the health watchdog prefers for its probe through the tunnel (it
  # falls back to a TCP connect without it, but UDP DNS is the truer signal).
  apt_install openconnect vpnc-scripts pipx bind9-dnsutils \
    || echo "WARN: vpn apt packages failed to install"
  have openconnect-saml || pipx install openconnect-saml >/dev/null 2>&1 \
    || echo "WARN: openconnect-saml install failed (needed for embedded-SAML head-ends)"
{{ end }}
{{ if $docker }}
  # docker — a docker engine inside the Linux VM itself (on macOS, OrbStack via "dev"
  # provides one). docker.io + compose v2 from apt; the user joins the docker group so
  # `docker` works without sudo.
  apt_install docker.io docker-compose-v2 \
    || echo "WARN: docker apt packages failed to install"
  if have docker && ! id -nG "$(id -un)" | grep -qw docker; then
    $SUDO usermod -aG docker "$(id -un)" \
      && echo "==> added $(id -un) to the docker group — log out and back in for it to apply"
  fi
  $SUDO systemctl enable --now docker >/dev/null 2>&1 || true
{{ end }}

  # Install these separately so a per-tool miss can't block the batch above.
  if ! have eza; then
    apt_install eza 2>/dev/null \
      || echo "WARN: eza not in apt (Ubuntu 24.04+ only) — see https://eza.rocks"
  fi
  have zoxide || apt_install zoxide 2>/dev/null \
    || echo "WARN: zoxide not in apt (24.04+) — see https://github.com/ajeetdsouza/zoxide"
  have delta  || apt_install git-delta 2>/dev/null \
    || echo "WARN: git-delta not in apt — see https://dandavison.github.io/delta"
  # fd: apt package fd-find ships binary fdfind — zshrc aliases fd=fdfind.
  have fd || have fdfind || apt_install fd-find 2>/dev/null \
    || echo "WARN: fd-find not in apt — see https://github.com/sharkdp/fd"
else
  echo "WARN: apt-get not found; this installer targets Debian/Ubuntu."
fi

# core — upstream release binaries (macOS gets all three from Brewfile).
#
# fzf: apt's is too old on bookworm (0.38) and 24.04 (0.44). `fzf --zsh` needs 0.48 —
# without it Ctrl-T, Alt-C and ** are silently missing — and the `selected-bg` colour
# in ~/.zshrc needs 0.52, so an older fzf rejects every call (fzf-tab, the
# sessionizer, ssh-launch, extrakto). Test the capability, not `have fzf`: a box
# provisioned earlier still has apt's copy on PATH. The new one lands in
# ~/.local/bin, which comes first, so the old package can stay.
fzf --zsh >/dev/null 2>&1 || gh_release_install junegunn/fzf fzf 'fzf-%V-linux_%G.tar.gz'
# atuin: the MUSL build, not gnu. The gnu binary needs glibc 2.39 and fails to start
# on bookworm (2.36) and jammy (2.35) — and `have atuin` would then see it and never
# retry. Ctrl-R is atuin on every box, hence core.
have atuin || gh_release_install atuinsh/atuin atuin 'atuin-%R-unknown-linux-musl.tar.gz'
# oh-my-posh: a single static binary; the prompt config is ~/.config/oh-my-posh.
have oh-my-posh || gh_release_install JanDeDobbeleer/oh-my-posh oh-my-posh 'posh-linux-%G'

{{ if $devlite }}
have lazygit || gh_release_install jesseduffield/lazygit lazygit 'lazygit_%V_Linux_%A.tar.gz'

# Neovim: LazyVim needs >= 0.11.2, and apt ships 0.7.2 (bookworm), 0.9.5 (24.04),
# 0.10.4 (25.10). Gated on the version rather than `have nvim`, since an older box
# already has apt's /usr/bin/nvim; ~/.local/bin/nvim comes first on PATH. The release
# tarball is a whole tree (runtime files, bundled parsers), so it is kept as one in
# ~/.local/opt/nvim and only the binary is linked into ~/.local/bin.
_nv="$(nvim --version 2>/dev/null | sed -n '1s/^NVIM v\([0-9][0-9.]*\).*/\1/p')"
if [ -z "$_nv" ] || ! printf '%s\n' 0.11.2 "$_nv" | sort -C -V; then
  gh_release_install neovim/neovim nvim 'nvim-linux-%A.tar.gz' "$HOME/.local/opt/nvim"
fi
unset _nv

# yq — mikefarah's (Go, jq-style YAML), the one Brewfile.devlite installs on macOS.
# NEVER apt's `yq`: that package is kislyuk's Python jq wrapper, a different tool
# with different flags. Checked by --version for the same reason: a box may already
# have apt's under the same name.
yq --version 2>/dev/null | grep -q mikefarah \
  || gh_release_install mikefarah/yq yq 'yq_linux_%G'

# worktrunk (`wt`) — git worktrees in sibling repo.branch directories, for running
# agents in parallel. Linux releases are musl .tar.xz only. Shell integration is the
# guarded `wt config shell init zsh` in ~/.zshrc; never `wt config shell install`,
# which would edit a ~/.zshrc that chezmoi owns.
have wt || gh_release_install max-sixty/worktrunk wt 'worktrunk-%R-unknown-linux-musl.tar.xz'
{{ end }}
{{ if $dev }}
# dev — the container layer. OrbStack is macOS-only, so on Linux this is just the
# clients; the engine itself comes from the "docker" feature (apt docker.io) or from a
# DOCKER_HOST pointing somewhere else.
have lazydocker || gh_release_install jesseduffield/lazydocker lazydocker 'lazydocker_%V_Linux_%A.tar.gz'
have dive || gh_release_install wagoodman/dive dive 'dive_%V_linux_%G.tar.gz'
{{ end }}
{{ if $k8s }}
# sofka — Kubernetes TUI in Rust: generic CRD pipeline, Flux/Argo actions built in,
# `X` incident view.
have sofka || gh_release_install nklmilojevic/sofka sofka 'sofka-v%V-%R-unknown-linux-gnu.tar.gz'

# argocd — login persists across VMs via dotenv-persist (.config/argocd/config).
have argocd || gh_release_install argoproj/argo-cd argocd 'argocd-linux-%G'

# kubectl lives on dl.k8s.io, not in a GitHub release. On macOS it comes from OrbStack
# (Brewfile.dev) instead; on Linux there is no equivalent, and the k8s tools without
# kubectl are half a toolchain.
# stable.txt is whatever upstream just released; kubectl supports a server within one
# minor of itself, so hardcode a version here if a cluster ever falls further behind.
have kubectl || install_bin kubectl \
  "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/%G/kubectl"

# helm — its GitHub releases carry no assets; the tarballs live on get.helm.sh, with
# the binary under linux-<arch>/. macOS gets it from Brewfile.k8s.
have helm || install_bin helm \
  "https://get.helm.sh/helm-$(curl -fsSL https://get.helm.sh/helm-latest-version)-linux-%G.tar.gz"
{{ end }}

{{ else -}}
echo "WARN: unsupported OS '{{ .chezmoi.os }}' — install tmux/atuin/oh-my-posh manually."
{{ end -}}

# bat >= 0.26 bundles the Catppuccin themes (Homebrew ships that); apt's 0.25 does not,
# and then BOTH ~/.zshrc's BAT_THEME and delta's syntax-theme below print
# "Unknown theme 'Catppuccin Macchiato', using default" on every cat and git diff.
# delta has no theme store of its own — it reads bat's compiled cache — so one
# download + `bat cache --build` fixes both. Gated on the theme list, not on the
# file, so a bat that already bundles it never gets a redundant user copy.
_bat=""; have bat && _bat=bat; [ -z "$_bat" ] && have batcat && _bat=batcat
if [ -n "$_bat" ] && ! "$_bat" --list-themes 2>/dev/null | grep -qx "Catppuccin Macchiato"; then
  echo "==> installing bat theme Catppuccin Macchiato"
  _btd="$("$_bat" --config-dir 2>/dev/null)"
  if [ -z "$_btd" ]; then
    echo "WARN: bat --config-dir failed; theme not installed"
  elif mkdir -p "$_btd/themes" && curl -fLso "$_btd/themes/Catppuccin Macchiato.tmTheme" \
      "https://github.com/catppuccin/bat/raw/main/themes/Catppuccin%20Macchiato.tmTheme"; then
    "$_bat" cache --build >/dev/null 2>&1 || echo "WARN: bat cache --build failed"
  else
    echo "WARN: bat theme download failed"
  fi
  unset _btd
fi
unset _bat

if have delta && have git; then
  git config --global core.pager "delta"
  git config --global interactive.diffFilter "delta --color-only"
  git config --global delta.navigate true
  git config --global delta.line-numbers true
  git config --global delta.dark true
  git config --global delta.syntax-theme "Catppuccin Macchiato"
  git config --global merge.conflictStyle zdiff3
fi

{{ if $devlite }}
# git-lfs is inert until `git lfs install` registers its clean/smudge filters in
# ~/.gitconfig: without that, a clone of an LFS repo checks out the pointer stubs and
# nothing says so. Global once per box; idempotent, so cheap to repeat on every apply.
if have git-lfs; then
  git lfs install --skip-repo >/dev/null 2>&1 || echo "WARN: git lfs install failed"
fi
{{ end }}

{{ if $k8s }}
# helmfmt — formatter for the Go-template side of Helm charts (aligns {{ "{{ if }}" }} /
# range / end indentation, leaves the YAML alone). No Homebrew formula, but its
# releases ship a root-level binary for both OSes, so this runs on macOS too — the
# only tool here that does. Wire it up per project via .helmfmt / pre-commit.
have helmfmt || gh_release_install digitalstudium/helmfmt helmfmt 'helmfmt_{{ title .chezmoi.os }}_%A.tar.gz'
{{ end }}

{{ if $devlite }}
if have gh; then
  gh extension list 2>/dev/null | grep -q 'dlvhdr/gh-dash' \
    || gh extension install dlvhdr/gh-dash >/dev/null 2>&1 || true
fi

# pnpm — the package manager most JS projects here pin (`packageManager` field); it
# takes over from itself once installed, so this bootstrap copy only has to exist.
# prettier — a global copy so LazyVim's formatter (conform → prettier) works in a
# checkout that doesn't ship it as a devDependency, and `prettier` is on PATH for
# one-off formatting outside any project.
npm_global_install pnpm pnpm
npm_global_install prettier prettier
{{ end }}

{{ if $ai }}
# ai — coding agents. Both ship on npm with zero dependencies and self-update
# afterwards, so this only has to bootstrap them. `claude` and `codex` authenticate
# per machine; the credentials are shared between VMs by dotenv-persist.
# The node floors come from each package's own "engines" field.
npm_global_install @anthropic-ai/claude-code claude 22
npm_global_install @openai/codex codex 16
# Backlog.md (MrLesk) — markdown task board with a TUI (`backlog board`) and a web UI
# (`backlog browser`). Ships prebuilt per-platform binaries as optionalDependencies,
# so there is no node floor and nothing to compile.
npm_global_install backlog.md backlog
{{ end }}

{{ if eq .chezmoi.os "linux" -}}
# This repo is zsh-only (~10 KB of ~/.zshrc: prompt, aliases, abbreviations, fzf-tab).
# On a box where the login shell is still bash — the default for a fresh Lima/cloud VM —
# ALL of it is inert, and nothing says so, which is easy to miss over ssh.
# macOS already defaults to zsh, so this is Linux-only. Opt out with DOTENV_NO_CHSH=1.
if [ "${DOTENV_NO_CHSH:-0}" != "1" ] && have zsh; then
  _SUDO=""; [ "$(id -u)" -ne 0 ] && _SUDO="sudo"
  _zsh="$(command -v zsh)"
  _cur="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)"
  if [ -n "$_cur" ] && [ "$_cur" != "$_zsh" ]; then
    grep -qxF "$_zsh" /etc/shells 2>/dev/null || echo "$_zsh" | $_SUDO tee -a /etc/shells >/dev/null
    # chsh prompts for a password under PAM; sudo works unattended where it's passwordless.
    if $_SUDO chsh -s "$_zsh" "$(id -un)" 2>/dev/null || chsh -s "$_zsh" 2>/dev/null; then
      echo "==> login shell -> $_zsh (was $_cur); takes effect on your next login"
    else
      echo "WARN: could not change login shell — run: chsh -s $_zsh"
    fi
  fi
  unset _SUDO _zsh _cur
fi
{{ end -}}

echo "==> dotenv: package step done"
