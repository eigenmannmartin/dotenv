#!/usr/bin/env bash
# Install tpm + all plugins from ~/.tmux.conf. Idempotent.
set -uo pipefail

TPM_DIR="$HOME/.tmux/plugins/tpm"

if ! command -v git >/dev/null 2>&1; then
  echo "WARN: git missing; skipping tmux plugins"; exit 0
fi

if [ ! -d "$TPM_DIR" ]; then
  echo "==> cloning tpm"
  git clone -q https://github.com/tmux-plugins/tpm "$TPM_DIR" \
    || { echo "WARN: tpm clone failed"; exit 0; }
fi

if command -v tmux >/dev/null 2>&1; then
  # This step is how a missing terminfo stayed invisible: tmux refuses to start when
  # $TERM has no entry here, install_plugins died instantly, and the output went to
  # /dev/null behind a generic WARN — leaving ~/.tmux/plugins with only tpm in it.
  # Fall back to a TERM that always resolves, and surface the real error.
  TPM_TERM="${TERM:-xterm-256color}"
  tput -T "$TPM_TERM" longname >/dev/null 2>&1 || TPM_TERM=xterm-256color
  echo "==> installing tmux plugins (TERM=$TPM_TERM)"
  _tpm_log="$(mktemp)"
  if TERM="$TPM_TERM" "$TPM_DIR/bin/install_plugins" >"$_tpm_log" 2>&1; then
    echo "==> tmux plugins installed"
  else
    echo "WARN: tmux plugin install had issues:"
    tail -n 10 "$_tpm_log"
  fi
  rm -f "$_tpm_log"
else
  echo "WARN: tmux not installed yet; run 'prefix + I' inside tmux later"
fi

echo "==> dotenv: tmux plugins done"
