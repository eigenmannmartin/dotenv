# 1Password secret references for `secrets` (~/.local/bin/secrets).
#
# NO SECRETS LIVE HERE — only pointers of the form op://<vault>/<item>/<field>.
# chezmoi creates this file once and then leaves it alone, so your edits stick.
#
#   secrets ls                    what is mapped
#   secrets get GH_TOKEN          resolve one
#   secrets run -- npm publish    run something with all of them exported
#   secrets login all             use them to log atuin + gh in
#
# Find the right reference for an item:  op item get "GitHub" --format json
# Names with spaces are fine and need no quoting.

ATUIN_USERNAME=op://Private/atuin/username
ATUIN_PASSWORD=op://Private/atuin/password
ATUIN_KEY=op://Private/atuin/key

GH_TOKEN=op://Private/GitHub/token

#ANTHROPIC_API_KEY=op://Private/Anthropic API/credential
#OPENAI_API_KEY=op://Private/OpenAI/api key
