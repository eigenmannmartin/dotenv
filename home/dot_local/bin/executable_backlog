#!/usr/bin/env bash
# backlog — BacklogMD's kanban board for the repo you are standing in.
#
# BacklogMD (backlogmd.com) is a protocol, not an app: the backlog is plain markdown
# under .backlogmd/ in the project, which agents read and write. This just runs the
# dashboard over it, and keeps that dashboard out of your way.
#
#   backlog              serve this repo's board in the background
#   backlog status       running? which repo, which port, which URL
#   backlog stop
#   backlog init         create the .backlogmd/ skeleton
#   backlog persist      move .backlogmd into the shared store so `vm rm` cannot eat it
#   -p/--port N          default 3030   |   --foreground   run attached
#
# Why this needs no port forwarding: Lima forwards every guest loopback listener to
# the Mac's 127.0.0.1, so a board served on localhost:3030 *inside* the VM opens at
# http://localhost:3030 in the Mac's browser. Same mechanism the VPN SSO callback
# uses. The flip side is that two VMs serving on 3030 collide on the host — give the
# second one -p 3031.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotenv"
PID_FILE="$STATE_DIR/backlog.pid"
LOG_FILE="$STATE_DIR/backlog.log"
META_FILE="$STATE_DIR/backlog.meta"

have() { command -v "$1" >/dev/null 2>&1; }
die()  { echo "backlog: $*" >&2; exit 1; }
usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

server_pid() {
  [ -r "$PID_FILE" ] || return 1
  local p; p="$(head -1 "$PID_FILE" 2>/dev/null | tr -dc '0-9')"
  [ -n "$p" ] || return 1
  # Guard against a recycled pid: the cmdline must still be the board server.
  grep -qa backlogmd "/proc/$p/cmdline" 2>/dev/null || return 1
  printf '%s' "$p"
}

# Prefer the globally installed binary; fall back to npx so this works on a box that
# only has the 'dev' feature. -y so npx never stops to ask about downloading.
serve_cmd() {
  if have backlogmd-serve; then printf 'backlogmd-serve'
  elif have npx;            then printf 'npx -y @backlogmd/serve'
  else die "neither backlogmd-serve nor npx found — install the 'ai' feature"; fi
}

PORT=3030; FOREGROUND=0
_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--port)    PORT="${2:?--port needs a value}"; shift 2 ;;
    --port=*)     PORT="${1#*=}"; shift ;;
    --foreground) FOREGROUND=1; shift ;;
    -h|--help)    usage 0 ;;
    *)            _args+=("$1"); shift ;;
  esac
done
set -- ${_args+"${_args[@]}"}

case "${1:-serve}" in
  init)
    root="$(repo_root)"
    mkdir -p "$root/.backlogmd/work"
    [ -e "$root/.backlogmd/backlog.md" ] || printf '# Backlog\n\n' > "$root/.backlogmd/backlog.md"
    echo "==> backlog: initialised $root/.backlogmd"
    echo "    it is globally gitignored (~/.config/git/ignore), so it will not be committed"
    ;;

  status)
    pid="$(server_pid || true)"
    [ -n "$pid" ] || { echo "backlog: not running"; exit 1; }
    dir=""; port=""
    # shellcheck disable=SC1090
    [ -r "$META_FILE" ] && . "$META_FILE"
    printf '==> backlog: serving (pid %s)\n' "$pid"
    printf '    %-6s %s\n' repo "${dir:-?}"
    printf '    %-6s http://localhost:%s\n' url "${port:-?}"
    printf '    %-6s %s\n' log "$LOG_FILE"
    echo "    (open that URL on the Mac too — Lima forwards guest loopback to the host)"
    ;;

  stop)
    pid="$(server_pid || true)"
    [ -n "$pid" ] || { echo "backlog: not running"; exit 0; }
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    rm -f "$PID_FILE" "$META_FILE"
    echo "==> backlog: stopped"
    ;;

  persist)
    # For a repo cloned INSIDE the VM, where .backlogmd would die with `vm rm`. A repo
    # on a --mount already lives on the Mac and needs none of this.
    root="$(repo_root)"
    [ -d "$root/.backlogmd" ] || die "no .backlogmd here — run 'backlog init' first"
    [ -L "$root/.backlogmd" ] && { echo "backlog: already persisted"; exit 0; }
    dirfile="${XDG_CONFIG_HOME:-$HOME/.config}/dotenv/persist-dir"
    [ -r "$dirfile" ] || die "this VM has no shared store (created with --no-persist?)"
    store="$(head -1 "$dirfile" | tr -d '[:space:]')/backlogmd/$(basename "$root")"
    [ -d "$store" ] && die "$store already exists — move or remove it first"
    mkdir -p "$(dirname "$store")"
    mv "$root/.backlogmd" "$store"
    ln -s "$store" "$root/.backlogmd"
    echo "==> backlog: .backlogmd now lives in $store"
    echo "    it survives 'vm rm', and every VM sharing that store sees the same board"
    ;;

  serve)
    root="$(repo_root)"
    [ -d "$root/.backlogmd" ] || die "no .backlogmd in $root — run 'backlog init'"
    # One board per VM, deliberately: it keeps the state files (and the forwarded
    # host port) unambiguous. A second repo means `backlog stop` and start again.
    if pid="$(server_pid || true)"; [ -n "$pid" ]; then
      serving=""; [ -r "$META_FILE" ] && . "$META_FILE" && serving="${dir:-}"
      die "already serving${serving:+ $serving} (pid $pid) — 'backlog stop' first"
    fi
    cmd="$(serve_cmd)"
    if [ "$FOREGROUND" = 1 ]; then
      echo "==> backlog: http://localhost:$PORT  ($root) — Ctrl-C to stop"
      exec $cmd --dir "$root" --port "$PORT" --host 127.0.0.1
    fi
    mkdir -p "$STATE_DIR"
    ( umask 077; : >> "$LOG_FILE" )
    # setsid so the board outlives the shell that started it (and the ssh session).
    setsid $cmd --dir "$root" --port "$PORT" --host 127.0.0.1 >>"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    printf 'dir=%q\nport=%q\n' "$root" "$PORT" > "$META_FILE"
    sleep 2
    server_pid >/dev/null || { echo "backlog: failed to start — see $LOG_FILE" >&2; exit 1; }
    echo "==> backlog: serving $root at http://localhost:$PORT (backlog stop)"
    have osc52-copy && printf 'http://localhost:%s' "$PORT" | osc52-copy 2>/dev/null \
      && echo "    URL copied to your Mac clipboard" || true
    ;;

  *) die "unknown command '$1' (serve|status|stop|init|persist)" ;;
esac
