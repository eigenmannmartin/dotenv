{{ if ne .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# cisco-vpn — Cisco AnyConnect VPN with Entra ID (SAML) SSO, from this *headless* Lima VM.
# LINUX ONLY: like pbcopy, this is a chezmoi template that renders empty on darwin —
# a Mac has a real browser (and Cisco Secure Client), so the console dance below is
# pointless there, and macOS packages belong in the Brewfile anyway.
#
# Why this works with no browser in the VM: openconnect >= 9.00 speaks the AnyConnect
# "external browser" SAML flow (--external-browser). It hands the IdP URL to a
# "browser" executable (exec'd directly, URL as $1 — a shell script works) and
# listens on loopback port 29786 ([::1] on 9.12) for the completion redirect. Lima
# auto-forwards every guest loopback listener — ::1 included — to 127.0.0.1 on the
# macOS host, so the URL is opened in Safari/Chrome ON THE MAC, Entra ID (incl.
# MFA/Conditional Access) runs there, and the browser's final localhost:29786
# redirect lands back inside the VM, straight into openconnect. Our "browser" is a
# stub that prints the URL — and drops it on the Mac clipboard through the pty
# (osc52-copy), so it's a Cmd-V away. Inside tmux, prefix+Tab (extrakto) also grabs
# it off the screen. Even if the stub failed, openconnect prints the URL itself and
# keeps listening. (On a non-Lima remote box the same flow works — bridge the
# redirect yourself with: ssh -L 29786:localhost:29786 <box>.)
#
# Server-side requirement: the ASA/FTD tunnel-group must allow external-browser SAML
# ("authentication saml external-browser", ASA 9.17(1)+/FTD 7.1+). Head-ends locked
# to the default *embedded* webview flow abort with "No SSO handler" on the CLI —
# console SSO can't work there (that flow needs a GUI webview, e.g. openconnect-sso).
set -euo pipefail

have() { command -v "$1" >/dev/null 2>&1; }

# One cleanup list, one trap. Separate `trap … EXIT` calls would silently replace
# each other, and this script now makes up to two temp files in a single run.
CLEANUP_FILES=()
cleanup() { rm -f ${CLEANUP_FILES+"${CLEANUP_FILES[@]}"}; }
trap cleanup EXIT

usage() {
  cat <<'EOF'
usage: cisco-vpn install                        one-time: openconnect (>= 9.00) + vpnc-scripts
       cisco-vpn <gateway> [openconnect args]   connect; SSO URL opens in a browser ON YOUR MAC
       cisco-vpn sso <gateway> [saml args]      same, for *embedded*-SAML head-ends
       cisco-vpn cookie <host> [fingerprint]    connect with an auth cookie read from stdin
       CISCO_VPN_SERVER=<gateway> cisco-vpn     gateway from the env instead

The gateway must come first; everything after it is passed through to openconnect
(e.g. cisco-vpn vpn.example.com --authgroup=Employees). Ctrl-C disconnects.

Use `sso` when plain mode dies with "No SSO handler" (e.g. vpn.unisg.ch): it drives
the login through openconnect-saml --headless, which prints a URL you open on the
Mac exactly like the native flow. One-time: pipx install openconnect-saml.

For a hands-free `sso`, load the browser extension in browser-extension/vpn-token-relay
(repo root, "Load unpacked" in chrome://extensions on the Mac). It spots the token
cookie and posts it to the callback below by itself — no bookmarklet, no pasting.

`cookie` is the manual variant — authenticate anywhere (incl. on the Mac with
`openconnect-saml --authenticate`), then pipe the cookie in:
  echo "$COOKIE" | cisco-vpn cookie "$HOST" "$FINGERPRINT"

Route control (works in every mode):
  --routes 10.1.0.0/16,192.168.50.0/24   send ONLY these through the tunnel
  --no-vpn-dns                           keep this VM's DNS; don't take the VPN's
  ~/.config/dotenv/vpn-routes            the same list, one CIDR per line, set once
  CISCO_VPN_ROUTES / CISCO_VPN_DNS=off   env equivalents
Without --routes you get whatever the head-end pushes — which for a full-tunnel
group means everything, including traffic that has no business on the corporate net.
EOF
  exit "${1:-0}"
}

SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"

# ---------------------------------------------------------------- route control
# openconnect hands the server's config to vpnc-script through the environment;
# vpnc-script installs a route per CISCO_SPLIT_INC_<n>_* triple, and falls back to
# a DEFAULT route through the tunnel when CISCO_SPLIT_INC is unset. So the clean
# place to narrow a tunnel is a shim in front of vpnc-script that overwrites those
# variables — no post-connect `ip route` racing, and it re-applies on reconnect.
# Setting a smaller count also masks any extra ranges the server pushed, since
# vpnc-script only reads indices 0..CISCO_SPLIT_INC-1.
masklen_to_mask() {
  local m="$1" o="" i part
  for i in 1 2 3 4; do
    if [ "$m" -ge 8 ]; then part=255; m=$((m - 8))
    else
      case "$m" in
        0) part=0 ;;   1) part=128 ;; 2) part=192 ;; 3) part=224 ;;
        4) part=240 ;; 5) part=248 ;; 6) part=252 ;; 7) part=254 ;;
      esac
      m=0
    fi
    o="$o.$part"
  done
  printf '%s' "${o#.}"
}

find_vpnc_script() {
  local c
  for c in /usr/share/vpnc-scripts/vpnc-script /etc/vpnc/vpnc-script /usr/local/etc/vpnc/vpnc-script; do
    [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# Emits the shim's path on stdout; callers pass it to openconnect as --script.
build_route_script() {
  local real f cidr addr len mask i=0
  real="$(find_vpnc_script)" || {
    echo "cisco-vpn: no vpnc-script found — install vpnc-scripts (cisco-vpn install)" >&2
    return 1
  }
  f="$(mktemp "${TMPDIR:-/tmp}/cisco-vpn-routes.XXXXXX")"
  ROUTE_SCRIPT="$f"; CLEANUP_FILES+=("$f")
  {
    echo '#!/bin/sh'
    echo '# generated by cisco-vpn — narrows the tunnel, then defers to vpnc-script'
    for cidr in $ROUTES; do
      addr="${cidr%%/*}"; len="${cidr#*/}"
      [ "$len" = "$cidr" ] && len=32          # a bare host address
      mask="$(masklen_to_mask "$len")"
      echo "CISCO_SPLIT_INC_${i}_ADDR=$addr;    export CISCO_SPLIT_INC_${i}_ADDR"
      echo "CISCO_SPLIT_INC_${i}_MASK=$mask;    export CISCO_SPLIT_INC_${i}_MASK"
      echo "CISCO_SPLIT_INC_${i}_MASKLEN=$len;  export CISCO_SPLIT_INC_${i}_MASKLEN"
      i=$((i + 1))
    done
    echo "CISCO_SPLIT_INC=$i; export CISCO_SPLIT_INC"
    # The VPN's nameservers otherwise replace resolv.conf wholesale, so *every*
    # lookup in this VM goes to the corporate resolver — a much wider change than
    # the routes you just restricted.
    [ "$VPN_DNS" = off ] && echo 'unset INTERNAL_IP4_DNS CISCO_DEF_DOMAIN'
    echo "exec $real \"\$@\""
  } > "$f"
  chmod 755 "$f"
}

validate_routes() {
  local cidr
  for cidr in $ROUTES; do
    case "$cidr" in
      *[!0-9./]*|""|/*|*/) echo "cisco-vpn: bad route '$cidr' (want a.b.c.d/len)" >&2; exit 2 ;;
    esac
  done
}

# Applied to every connect path, so `sso`, `cookie` and the native flow behave the
# same. Sets ROUTE_ARGS, which each openconnect invocation splices in.
ROUTE_ARGS=(); ROUTE_SCRIPT=""
setup_routes() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/dotenv/vpn-routes"
  if [ -z "$ROUTES" ] && [ -r "$file" ]; then
    ROUTES="$(sed 's/#.*//' "$file" | tr '\n' ' ')"
  fi
  ROUTES="$(printf '%s' "${ROUTES//,/ }" | tr -s '[:space:]' ' ')"
  ROUTES="${ROUTES# }"; ROUTES="${ROUTES% }"
  if [ -n "$ROUTES" ]; then
    validate_routes
    build_route_script || exit 1
    ROUTE_ARGS=(--script "$ROUTE_SCRIPT")
    echo "==> cisco-vpn: tunnelling only: $ROUTES"
    [ "$VPN_DNS" = off ] && echo "    keeping this VM's DNS"
  elif [ "$VPN_DNS" = off ]; then
    echo "cisco-vpn: --no-vpn-dns needs --routes (the shim is what carries it)" >&2
    exit 2
  fi
  return 0   # the branches above can end on a failing test; see connect_with_cookie
}

# Both cookie paths (sso and `cookie`) connect identically — cookie on stdin, and a
# UA/version pair mirroring openconnect-sso's, so version-checking DAP policies see a
# client they know.
connect_with_cookie() {
  local host="$1" fp="${2:-}"
  setup_routes
  set -- --cookie-on-stdin --useragent 'AnyConnect Linux_64 4.7.00136' --version-string 4.7.00136
  [ -n "$fp" ] && set -- "$@" --servercert "$fp"
  $SUDO openconnect --protocol=anyconnect ${ROUTE_ARGS+"${ROUTE_ARGS[@]}"} "$@" "$host"
}

# Consumed here rather than passed through, in every mode — hence the pre-parse.
ROUTES="${CISCO_VPN_ROUTES:-}"
VPN_DNS="${CISCO_VPN_DNS:-on}"
_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --routes)     ROUTES="${2:?--routes needs a value}"; shift 2 ;;
    --routes=*)   ROUTES="${1#*=}"; shift ;;
    --no-vpn-dns) VPN_DNS=off; shift ;;
    *)            _args+=("$1"); shift ;;
  esac
done
set -- ${_args+"${_args[@]}"}

install_openconnect() {
  if have apt-get; then
    $SUDO apt-get update -qq || true
    # DEBIAN_FRONTEND via `env`, not `export`: sudo's env_reset strips exported vars,
    # so the export form silently never reaches apt/dpkg/needrestart under sudo.
    # vpnc-scripts is a hard dep of the deb, but name it: it owns routes/DNS setup.
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openconnect vpnc-scripts \
      || { echo "cisco-vpn: apt install of openconnect failed" >&2; exit 1; }
  else
    echo "cisco-vpn: apt-get not found; this installer targets Debian/Ubuntu" >&2
    echo "           (any openconnect >= 9.00 with vpnc-script works — install manually)" >&2
    exit 1
  fi

  # Probe the capability, not just the version: SSO needs --external-browser
  # (openconnect >= 9.00; Ubuntu 22.04 still ships 8.20). No usable binary
  # fallback exists, so say so now instead of failing mid-login later.
  # NB: `openconnect --help` exits 1 by design — don't test it through pipefail.
  case "$(openconnect --help 2>&1 || true)" in
    *--external-browser*) ;;
    *)
      echo "WARN: this openconnect ($(openconnect --version 2>/dev/null | head -1)) lacks" >&2
      echo "      --external-browser — SSO needs >= 9.00 (Ubuntu 24.04+: 9.12, Debian 12+: 9.01+)." >&2
      ;;
  esac

  # Lima kernels ship tun built-in; probe anyway so a missing module fails here,
  # with a name, and not mid-connect.
  [ -e /dev/net/tun ] || $SUDO modprobe tun 2>/dev/null \
    || echo "WARN: /dev/net/tun missing — openconnect cannot create the tunnel" >&2

  echo "==> cisco-vpn: $(openconnect --version | head -1) ready"
  echo "    connect with: cisco-vpn <vpn-gateway>"
}

case "${1:-}" in
  -h|--help) usage 0 ;;
  install)   install_openconnect; exit 0 ;;
  sso)
    # Embedded-SAML head-ends ("No SSO handler") — still entirely from this VM.
    # openconnect-saml --headless supplies the webview openconnect lacks, and waits on
    # a local callback server. But in EMBEDDED mode nothing ever redirects there: the
    # ASA ends the flow on its own page (sso-v2-login-final) and leaves the token in
    # the *browser* as the cookie named by sso-v2-token-cookie-name (acSamlv2Token on
    # HSG). Verified against vpn.unisg.ch: no <sso-v2-browser-mode> is ever sent, so
    # the callback can only be fed from the browser side — hence the relay below. The
    # cookie is not HttpOnly, so the extension (or bookmarklet, or you) can post it
    # to the callback, which Lima forwards into this VM. openconnect-saml then does
    # the auth-reply POST that swaps the token for the real webvpn session cookie.
    shift
    [ $# -ge 1 ] || { echo "cisco-vpn: sso mode needs <gateway>" >&2; usage 2 >&2; }
    gw="$1"; shift
    have openconnect-saml || {
      echo "cisco-vpn: openconnect-saml missing — install it with:" >&2
      echo "           sudo apt-get install -y pipx && pipx install openconnect-saml" >&2
      echo "           (base package only: the [gui]/[chrome] extras need a display)" >&2
      exit 1
    }
    have openconnect || { echo "==> cisco-vpn: openconnect missing — installing first"; install_openconnect; }

    creds="$(mktemp "${TMPDIR:-/tmp}/cisco-vpn-creds.XXXXXX")"   # mktemp -> 0600
    CLEANUP_FILES+=("$creds")
    # PYTHONUNBUFFERED: Python block-buffers when stdout is a pipe, which would hide
    # the login URL until after the callback had already timed out. Backgrounded so
    # we can relay a pasted token while its callback server is still listening; no
    # --user is passed, so it never competes with us for the terminal.
    PYTHONUNBUFFERED=1 openconnect-saml --server "$gw" --headless --authenticate "$@" >"$creds" 2>&1 &
    saml_pid=$!

    # Wait for the login URL (and the callback port it chose — 29786 unless taken).
    login_url=""; cb_url=""
    for _ in $(seq 1 60); do
      kill -0 "$saml_pid" 2>/dev/null || break
      login_url="$(grep -oE 'https://[^ ]+saml[^ ]*' "$creds" | head -1 || true)"
      cb_url="$(grep -oE 'http://127\.0\.0\.1:[0-9]+' "$creds" | head -1 || true)"
      [ -n "$login_url" ] && [ -n "$cb_url" ] && break
      sleep 1
    done
    cb_port="${cb_url##*:}"

    if [ -n "$login_url" ]; then
      sso_osc52="$(command -v osc52-copy || true)"
      [ -n "$sso_osc52" ] && printf '%s' "$login_url" | "$sso_osc52" 2>/dev/null || true
      cat <<EOF

=========================== SSO login (embedded SAML) ===========================
Waiting for the token on callback port $cb_port.

1. Open this URL in a browser ON YOUR MAC (it is also on your clipboard):

   $login_url

2. Sign in. You land on a page saying you may close the tab — do NOT close it yet:
   the token is now a cookie there, and nothing sends it back automatically.
3. Getting the token back here, best first:
   a) NOTHING TO DO if the "Cisco VPN token relay" extension is loaded on the Mac
      (browser-extension/vpn-token-relay in this repo) — it posts the cookie itself.
   b) or click a bookmarklet saved on the Mac with this as its URL:

   javascript:(function(){var m=document.cookie.match(/acSamlv2Token=([^;]*)/);if(!m){alert('acSamlv2Token not found - are you on the vpn page?');return}location='http://localhost:$cb_port/callback?acSamlv2Token='+encodeURIComponent(m[1])})()

   c) or read it out (DevTools console: document.cookie) and paste it below.
================================================================================
EOF
      # Poll instead of a plain read: the bookmarklet may complete the login for us,
      # in which case openconnect-saml exits and there is nothing left to paste.
      token=""
      printf 'Waiting for the extension/bookmarklet — or paste acSamlv2Token here: '
      while kill -0 "$saml_pid" 2>/dev/null; do
        if read -r -t 5 token </dev/tty 2>/dev/null && [ -n "$token" ]; then
          curl -sG --data-urlencode "acSamlv2Token=$token" "$cb_url/callback" >/dev/null 2>&1 \
            && echo "==> token relayed to the local callback server" \
            || echo "WARN: could not reach $cb_url — did the login time out?" >&2
          break
        fi
      done
      echo
    fi

    wait "$saml_pid" || true
    # || true: grep exits 1 when it selects nothing, which pipefail would turn into
    # a silent abort right before the cookie is read.
    { grep -v -E '^(HOST|COOKIE|FINGERPRINT)=' "$creds" || true; } | tail -5

    # Values are shlex-quoted by openconnect-saml; eval is its documented consumption.
    eval "$(grep -E '^(HOST|COOKIE|FINGERPRINT)=' "$creds" || true)"
    [ -n "${COOKIE:-}" ] || { echo "cisco-vpn: no cookie returned — SSO did not complete" >&2; exit 1; }

    echo "==> cisco-vpn: SSO complete — connecting to ${HOST:-$gw} (Ctrl-C disconnects)"
    printf '%s' "$COOKIE" | connect_with_cookie "${HOST:-$gw}" "${FINGERPRINT:-}"
    exit $?
    ;;

  cookie)
    # Embedded-SAML escape hatch: the browser part already happened on the Mac
    # (openconnect-sso --authenticate printed HOST/COOKIE/FINGERPRINT); we only
    # consume the cookie here. The UA/version pair mirrors what openconnect-sso
    # itself connects with, so version-checking DAP policies see a known client.
    # NB: Ctrl-C logs the session out server-side and BURNS the cookie; a plain
    # network drop (or SIGHUP) keeps it reusable.
    shift
    [ $# -ge 1 ] || { echo "cisco-vpn: cookie mode needs <host> [fingerprint]" >&2; usage 2 >&2; }
    host="$1"; fp="${2:-}"
    have openconnect || { echo "==> cisco-vpn: openconnect missing — installing first"; install_openconnect; }
    echo "==> cisco-vpn: connecting to $host with handed-over cookie (Ctrl-C disconnects)"
    connect_with_cookie "$host" "$fp"      # cookie arrives on our stdin
    exit $?
    ;;
esac

# First non-flag arg is the gateway; anything else passes through to openconnect.
server="${CISCO_VPN_SERVER:-}"
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then server="$1"; shift; fi
[ -n "$server" ] || { echo "cisco-vpn: no gateway given (arg or \$CISCO_VPN_SERVER)" >&2; usage 2 >&2; }

have openconnect || { echo "==> cisco-vpn: openconnect missing — installing first"; install_openconnect; }

# The "browser" openconnect launches: print the URL + best-effort OSC 52 copy to the
# Mac clipboard. Generated fresh per run because openconnect execs it as root with no
# shell and outside our PATH — so it must be a real file with absolute paths baked in.
osc52="$(command -v osc52-copy || true)"
helper="$(mktemp "${TMPDIR:-/tmp}/cisco-vpn-browser.XXXXXX")"
CLEANUP_FILES+=("$helper")
cat >"$helper" <<EOF
#!/bin/sh
# Invoked by openconnect with the SSO URL as \$1 (stdout arrives on its stderr).
printf '\n================================ SSO login ================================\n'
printf 'Open this URL in a browser ON YOUR MAC (not in the VM):\n\n%s\n\n' "\$1"
printf 'Entra ID login runs there; the final http://localhost:29786/ redirect is\n'
printf 'forwarded by Lima back into this VM to complete authentication.\n'
printf '===========================================================================\n\n'
[ -x "$osc52" ] && printf '%s' "\$1" | "$osc52" 2>/dev/null \
  && printf '(URL is also on your Mac clipboard — OSC 52.)\n\n'
exit 0
EOF
chmod 755 "$helper"

# Troubleshooting:
#  - "No SSO handler"        -> head-end only allows *embedded* SAML (e.g. vpn.unisg.ch);
#                               use `cisco-vpn sso` instead.
#  - 404 right after connect -> some ASA DAP policies match the User-Agent; retry
#                               with: --useragent='AnyConnect Linux_64 4.10.05095'
#                               (openconnect's default already contains "AnyConnect").
#  - exits after hours up    -> the session cookie expired or the head-end ended the
#                               session; that's fatal by design (no headless token
#                               refresh) — rerun and redo the browser login. Brief
#                               network drops reconnect on their own.
setup_routes
echo "==> cisco-vpn: connecting to $server (Ctrl-C disconnects)"
$SUDO openconnect --protocol=anyconnect --external-browser="$helper" \
  ${ROUTE_ARGS+"${ROUTE_ARGS[@]}"} "$@" "$server"
{{ end -}}
