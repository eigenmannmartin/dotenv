#!/usr/bin/env bash
# dotenv-persist — keep logins alive across VM rebuilds.
#
# A Lima VM is disposable; the logins inside it are not. `vm new` mounts one small
# host directory (default ~/.local/share/dotenv/vm-logins, path recorded in
# ~/.config/dotenv/persist-dir) and this replaces the credential files in $HOME with
# symlinks into it. Log in once, on any VM, and every VM after that is already
# logged in — atuin, gh, claude, and the 1Password service-account token.
#
#   dotenv-persist              link everything (idempotent; safe to re-run)
#   dotenv-persist status       show what is shared, local, or not yet created
#   dotenv-persist add PATH     also share $HOME/PATH from now on
#   dotenv-persist unshare PATH stop sharing it and put the real file back
#   dotenv-persist project DIR  share a dir from the CURRENT REPO (e.g. .backlog)
#
# Re-running it re-captures anything that came unlinked: several of these tools write
# a credential by rename(), which replaces our symlink with a real file, so the token
# they just refreshed would live in this VM only and die with it. The newer of the two
# copies wins, and the loser is kept as .dotenv-bak rather than deleted.
#
# ~/.zshrc does that on every shell start, because remembering to is not a plan —
# claude refreshes its OAuth token mid-session, silently, hours after any login.
#
# What is NOT shared, deliberately: atuin's history.db. SQLite over a virtiofs/sshfs
# mount is a corruption risk, and it does not need sharing — the key and session
# below are what let `atuin sync` pull the same history down into every VM.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotenv"
DIR_FILE="$CONFIG_DIR/persist-dir"
LIST_FILE="$CONFIG_DIR/persist-paths"

die() { echo "dotenv-persist: $*" >&2; exit 1; }

# Paths are relative to $HOME. A trailing / means "link the whole directory", which
# is the robust choice when a tool rewrites files inside it atomically.
#
# NOT here on purpose: ~/.config/op. The 1Password CLI refuses to run at all when its
# config directory is a symlink ("we can't safely access ... because it's a symbolic
# link"), and it has a --config flag but no env var, so there is no way to point it
# elsewhere for every invocation. It costs nothing to leave out: with a service
# account the token below IS the credential, and `secrets` reads that itself, so op
# never looks at a shared path. Check for this before adding any config directory —
# credential *files* are the safe thing to share.
#
# The three Claude Code entries are one unit — with only the credentials shared, a new
# VM was logged in but re-ran onboarding and had no /resume list, which reads exactly
# like "the login didn't persist":
#   .claude/.credentials.json  the OAuth tokens
#   .claude.json               account, onboarding state, and the per-project MRU list
#                              /resume is built from — useless without the transcripts
#   .claude/projects/          the transcripts themselves, one .jsonl per session
# The two runai entries are what makes the CLI installable at all on a fresh VM:
# every Run:ai control-plane download endpoint sits behind SSO, and the install
# script (20-install-packages, k8s feature) bootstraps the binary with the bearer
# token from authentication.json — which the CLI refreshes whenever it is used on
# any box sharing this store. config.json carries the control-plane URL + cluster.
DEFAULT_PATHS='
.local/share/atuin/key
.local/share/atuin/session
.config/gh/hosts.yml
.config/git/identity
.claude/.credentials.json
.claude.json
.claude/projects/
.config/dotenv/op-service-account-token
.runai/authentication.json
.runai/config.json
'

# One cleaned entry per line — comments, whitespace and blanks already gone, so the
# consumers below can just read lines.
paths() {
  { if [ -r "$LIST_FILE" ]; then cat "$LIST_FILE"; else printf '%s' "$DEFAULT_PATHS"; fi; } \
    | sed 's/#.*//' | tr -d '[:blank:]' | grep -v '^$' || true
}

persist_dir() {
  [ -r "$DIR_FILE" ] || return 1
  local d; d="$(head -1 "$DIR_FILE" | tr -d '[:space:]')"
  [ -n "$d" ] || return 1
  printf '%s' "$d"
}

safe_rel() {
  case "$1" in
    ""|/*|*..*) return 1 ;;
    *) return 0 ;;
  esac
}

link_one() {
  local rel="$1" isdir=0
  case "$rel" in */) isdir=1; rel="${rel%/}" ;; esac
  safe_rel "$rel" || { echo "dotenv-persist: skipping unsafe path '$1'" >&2; return 0; }
  local src="$HOME/$rel" dst="$PERSIST/$rel"

  # Already ours and pointing at the right place — nothing to do.
  if [ -L "$src" ] && [ "$(readlink "$src")" = "$dst" ]; then return 0; fi

  mkdir -p "$(dirname "$dst")" "$(dirname "$src")"

  if [ -e "$src" ] && [ ! -L "$src" ]; then
    if [ ! -e "$dst" ]; then
      mv "$src" "$dst"                       # first login: capture it
      echo "  captured $rel"
    elif [ "$isdir" = 0 ] && [ "$src" -nt "$dst" ]; then
      # This VM has the newer credential — which is the normal case when a tool
      # rotated it by rename() and clobbered our symlink. Promote it, or we would
      # quietly restore the token the login just replaced.
      mv "$dst" "$dst.dotenv-bak"
      mv "$src" "$dst"
      echo "  captured newer $rel (previous shared copy: $rel.dotenv-bak)"
    else
      # Shared copy is newer (or it is a directory, which cannot be merged).
      # Never throw the local one away silently — a stale .bak beats a lost token.
      mv "$src" "$src.dotenv-bak"
      echo "  local $rel kept as $rel.dotenv-bak (shared copy is newer)"
    fi
  else
    rm -f "$src"                             # dangling or stale symlink
  fi

  # A dangling symlink is intentional when neither side exists yet: the parent dir
  # is there, so the tool's first write follows the link and lands on the host.
  if [ "$isdir" = 1 ] && [ ! -e "$dst" ]; then mkdir -p "$dst"; fi
  ln -sfn "$dst" "$src"
}

# Before the store check below, which otherwise swallows --help on any machine that
# has no shared store — i.e. every Mac and devcontainer.
case "${1:-}" in
  -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

PERSIST=""
if ! PERSIST="$(persist_dir)"; then
  case "${1:-link}" in
    status) echo "not shared — no $DIR_FILE (VM created with --no-persist?)"; exit 0 ;;
    *)      exit 0 ;;   # a plain Mac / devcontainer: nothing to do, not an error
  esac
fi
[ -d "$PERSIST" ] || die "persist dir '$PERSIST' is not mounted — is the VM's mount up?"

case "${1:-link}" in
  link)
    # ~/.zshrc re-links on every shell start, so several runs can now overlap — tmux
    # restoring a session opens its panes at once. Two of them racing over the same
    # mv pair could drop a credential, and a duplicate run has nothing to add anyway,
    # so losing the race exits quietly. The staleness reap is what keeps a run killed
    # mid-flight from disabling re-linking on this box forever.
    LOCK="$CONFIG_DIR/.persist-lock"
    if [ -d "$LOCK" ] && [ -z "$(find "$LOCK" -maxdepth 0 -mmin -1 2>/dev/null)" ]; then
      rmdir "$LOCK" 2>/dev/null || true
    fi
    mkdir "$LOCK" 2>/dev/null || exit 0
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

    echo "==> dotenv-persist: sharing logins via $PERSIST"
    while IFS= read -r rel; do
      link_one "$rel"
    done <<EOF
$(paths)
EOF
    ;;

  status)
    printf '%-46s %s\n' "PATH" "STATE"
    while IFS= read -r rel; do
      rel="${rel%/}"
      if [ -L "$HOME/$rel" ] && [ "$(readlink "$HOME/$rel")" = "$PERSIST/$rel" ]; then
        [ -e "$HOME/$rel" ] && printf '%-46s %s\n' "$rel" "shared" \
                            || printf '%-46s %s\n' "$rel" "shared (not created yet)"
      elif [ -e "$HOME/$rel" ]; then
        printf '%-46s %s\n' "$rel" "LOCAL — run: dotenv-persist"
      else
        printf '%-46s %s\n' "$rel" "absent"
      fi
    done <<EOF
$(paths)
EOF
    ;;

  add)
    rel="${2:?usage: dotenv-persist add <path relative to \$HOME>}"
    safe_rel "${rel%/}" || die "'$rel' must be relative to \$HOME and must not contain '..'"
    if [ ! -r "$LIST_FILE" ]; then
      # Materialise the defaults first. NOT `paths > "$LIST_FILE"`: the redirect
      # creates the file before paths() runs, so paths() would read it back empty
      # and the defaults would be silently dropped.
      defaults="$(paths)"
      { echo "# Files shared between VMs by dotenv-persist, relative to \$HOME."
        echo "# A trailing / means link the whole directory."
        printf '%s\n' "$defaults"; } > "$LIST_FILE"
    fi
    grep -qxF "$rel" "$LIST_FILE" || printf '%s\n' "$rel" >> "$LIST_FILE"
    link_one "$rel"
    echo "==> added $rel to $LIST_FILE"
    ;;

  project)
    # Per-PROJECT state, as opposed to the $HOME-relative credentials above: move a
    # directory out of the repo into the shared store and symlink it back. Written for
    # Backlog.md's task folder — the board should outlive `vm rm` without being
    # committed — but nothing here is specific to it.
    #
    # Only needed when the repo lives INSIDE the VM. A repo on a `vm --mount` is
    # already on the Mac's disk and survives a rebuild on its own.
    rel="${2:?usage: dotenv-persist project <dir relative to the repo root>}"; rel="${rel%/}"
    safe_rel "$rel" || die "'$rel' must be inside the repo and must not contain '..'"
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    src="$root/$rel"
    dst="$PERSIST/projects/$(basename "$root")/$rel"
    if [ -L "$src" ]; then
      echo "==> $rel is already shared (-> $(readlink "$src"))"; exit 0
    fi
    [ -e "$src" ] || die "no $rel in $root"
    [ -e "$dst" ] && die "$dst already exists — move or remove it first"
    mkdir -p "$(dirname "$dst")"
    mv "$src" "$dst"
    ln -s "$dst" "$src"
    echo "==> $rel now lives in $dst"
    echo "    it survives 'vm rm', and every VM on this store sees the same content"
    echo "    remember to gitignore $rel if it should stay out of the repo"
    ;;

  unshare)
    # For paths a tool turns out to reject as a symlink (see ~/.config/op above), and
    # for anything you would rather keep VM-local. The shared copy is moved back into
    # $HOME so nothing is lost; other VMs stop seeing updates to it.
    rel="${2:?usage: dotenv-persist unshare <path relative to \$HOME>}"; rel="${rel%/}"
    safe_rel "$rel" || die "'$rel' must be relative to \$HOME and must not contain '..'"
    src="$HOME/$rel"; dst="$PERSIST/$rel"
    [ -L "$src" ] || die "$rel is not a shared symlink"
    rm -f "$src"
    if [ -e "$dst" ]; then
      mkdir -p "$(dirname "$src")"
      mv "$dst" "$src"
      echo "==> moved $rel out of the shared store and back into \$HOME"
    else
      echo "==> removed the $rel link (the shared store had nothing behind it)"
    fi
    # Only touch the list if it exists; otherwise the defaults still apply and the
    # entry may simply no longer be one of them.
    if [ -r "$LIST_FILE" ]; then
      # || true: grep exits 1 when it selects nothing, which would leave the tmp file
      # behind and skip the mv.
      { grep -vxF "$rel" "$LIST_FILE" || true; } > "$LIST_FILE.tmp"
      mv "$LIST_FILE.tmp" "$LIST_FILE"
    fi
    ;;

  *) die "unknown command '$1' (link|status|add|unshare|project)" ;;
esac
