#!/usr/bin/env bash
# dx — run a command inside the current repo's devcontainer (Claude stays on the host; git/build/test
# run in the container, where commit signing + push go through the forwarded host 1Password agent).
#
#   dx git commit -m "msg"     # signs via 1Password (approve the popup) — run in the FOREGROUND
#   dx git push                # SSH push via the forwarded 1Password agent
#   dx npm test                # or any project dependency available in the container
#
# Brings the container up on first use. Repos need a .devcontainer/ (copy dotenv's as a template).
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "dx: not inside a git repo" >&2; exit 1; }
[ -e "$root/.devcontainer" ] || { echo "dx: no .devcontainer/ in $root — copy dotenv's as a template" >&2; exit 1; }
command -v devcontainer >/dev/null || { echo "dx: devcontainer CLI missing (npm i -g @devcontainers/cli)" >&2; exit 1; }

# Where the container should find the 1Password agent. OrbStack/Docker Desktop expose
# the Mac's agent at a fixed magic path (the real socket is outside their VM and cannot
# be bind-mounted); a dockerd running inside a Lima VM has no such path, but the agent
# socket forwarded into that VM is an ordinary file it CAN mount. devcontainer.json
# falls back to the magic path when this is unset.
if [ ! -S /run/host-services/ssh-auth.sock ] && [ -S "${SSH_AUTH_SOCK:-}" ]; then
  export DEVCONTAINER_SSH_SOCK="$SSH_AUTH_SOCK"
fi

if [ -z "$(docker ps -q -f "label=devcontainer.local_folder=$root" 2>/dev/null)" ]; then
  echo "dx: starting devcontainer for $root …" >&2
  devcontainer up --workspace-folder "$root" >&2
fi

exec devcontainer exec --workspace-folder "$root" -- "$@"
