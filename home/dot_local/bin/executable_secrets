#!/usr/bin/env bash
# secrets — pull values out of 1Password into env vars and login prompts.
#
# The map lives in ~/.config/dotenv/secrets.env: plain `NAME=op://vault/item/field`
# lines, no secret values, safe to read. Everything below resolves those refs at the
# moment you need them, so nothing is ever written to disk or left in your shell.
#
#   secrets run -- terraform apply     run a command with every ref exported
#   secrets shell                      a subshell with them exported
#   secrets get GH_TOKEN               print one value (careful: that is stdout)
#   secrets export                     eval-able `export …` lines
#   secrets login atuin|gh|all         drive a tool's login with them
#   secrets ls | secrets check | secrets install
#
# Auth in a headless VM: `op` cannot use Touch ID or the desktop app there, so use a
# 1Password *service account* — put its token in
# ~/.config/dotenv/op-service-account-token (chmod 600) and everything here is
# non-interactive. dotenv-persist shares that file across VMs, so you paste it once.
# Without one, `op` falls back to `op signin`, which will prompt.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotenv"
REFS="$CONFIG_DIR/secrets.env"
TOKEN_FILE="$CONFIG_DIR/op-service-account-token"

have() { command -v "$1" >/dev/null 2>&1; }
die()  { echo "secrets: $*" >&2; exit 1; }

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

install_op() {
  if have op; then echo "==> secrets: $(op --version) already installed"; return 0; fi
  if [ "$(uname -s)" = "Darwin" ]; then
    have brew || die "install Homebrew first, or grab the CLI from 1password.com/downloads/command-line"
    brew install --cask 1password-cli
    return 0
  fi
  have apt-get || die "no apt-get — install op from 1password.com/downloads/command-line"
  local sudo="" arch
  [ "$(id -u)" -ne 0 ] && sudo="sudo"
  case "$(uname -m)" in
    x86_64)  arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) die "unsupported arch $(uname -m)" ;;
  esac
  # The signed apt repo rather than a pinned zip: op refuses to talk to the service
  # when it falls too far behind the server, so it needs to update with the system.
  $sudo install -d -m 0755 /usr/share/keyrings
  curl -sSf https://downloads.1password.com/linux/keys/1password.asc \
    | $sudo gpg --dearmor --yes --output /usr/share/keyrings/1password-archive-keyring.gpg
  printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' \
    "$arch" "$arch" | $sudo tee /etc/apt/sources.list.d/1password.list >/dev/null
  $sudo apt-get update -qq
  $sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq 1password-cli
  echo "==> secrets: $(op --version) installed"
}

need_op() {
  have op || { echo "==> secrets: op missing — installing"; install_op; }
  # op aborts with a cryptic "we can't safely access ... because it's a symbolic
  # link" here. Older VMs may still carry that link from when dotenv-persist shared
  # this directory; say what to do instead of letting op's message land cold.
  if [ -L "${XDG_CONFIG_HOME:-$HOME/.config}/op" ]; then
    die "~/.config/op is a symlink and op refuses to use it — run: dotenv-persist unshare .config/op"
  fi
  # Token goes into op's environment only, never exported into this shell (and so
  # never into anything `secrets run` starts).
  if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -r "$TOKEN_FILE" ]; then
    OP_SERVICE_ACCOUNT_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
    # An `[ … ] && export` here would return 1 for an empty token file, and as the
    # last statement of the function that aborts the whole script under `set -e`.
    if [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
      export OP_SERVICE_ACCOUNT_TOKEN
    else
      unset OP_SERVICE_ACCOUNT_TOKEN
      echo "secrets: $TOKEN_FILE is empty — falling back to interactive op auth" >&2
    fi
  fi
}

need_refs() {
  [ -r "$REFS" ] || die "no $REFS — write NAME=op://vault/item/field lines there"
  grep -qE '^[A-Za-z_][A-Za-z0-9_]*=op://' "$REFS" \
    || die "no active refs in $REFS (every line commented out?)"
}

# NAME=op://… lines only, comments and blanks dropped.
ref_lines() { grep -E '^[A-Za-z_][A-Za-z0-9_]*=op://' "$REFS" || true; }

# Returns 1 for an unknown name rather than dying: die() inside $(…) would only kill
# the subshell, and the caller would sail on with an empty ref.
ref_for() {
  local line
  line="$(ref_lines | grep -m1 "^$1=" || true)"
  [ -n "$line" ] || return 1
  printf '%s' "${line#*=}"
}

# Resolve a ref, but treat "not in your vault" as a soft miss so the login helpers
# can skip a tool instead of aborting the whole run.
try_read() { op read "$1" 2>/dev/null || true; }

login_atuin() {
  have atuin || { echo "  atuin not installed — skipped"; return 0; }
  local u p k ru rp rk
  ru="$(ref_for ATUIN_USERNAME)" || die "atuin: no ATUIN_USERNAME ref in $REFS"
  rp="$(ref_for ATUIN_PASSWORD)" || die "atuin: no ATUIN_PASSWORD ref in $REFS"
  rk="$(ref_for ATUIN_KEY)"      || die "atuin: no ATUIN_KEY ref in $REFS"
  u="$(try_read "$ru")"; p="$(try_read "$rp")"; k="$(try_read "$rk")"
  [ -n "$u" ] && [ -n "$p" ] && [ -n "$k" ] || die "atuin: 1Password returned nothing for one of $ru / $rp / $rk"
  # The session file is what "logged in" actually means, and it is the artifact
  # dotenv-persist shares — cheaper and steadier than parsing `atuin status` output.
  if [ -s "${ATUIN_DATA_DIR:-$HOME/.local/share/atuin}/session" ]; then
    echo "  atuin already logged in — syncing"
  else
    # -p puts the password on argv, where `ps` can see it for the duration of the
    # call. atuin reads the password from the tty otherwise, which cannot be piped,
    # so this is the only non-interactive option; the exposure is one command, in
    # your own VM. Log in interactively (`atuin login -u "$u" -k "$k"`) to avoid it.
    atuin login -u "$u" -p "$p" -k "$k"
  fi
  atuin sync || true
  echo "  atuin: ok"
}

login_gh() {
  have gh || { echo "  gh not installed — skipped"; return 0; }
  local t r
  r="$(ref_for GH_TOKEN)" || die "gh: no GH_TOKEN ref in $REFS"
  t="$(try_read "$r")"
  [ -n "$t" ] || die "gh: 1Password returned nothing for $r"
  # --with-token reads stdin, so the token never reaches argv or the environment.
  printf '%s' "$t" | gh auth login --with-token
  gh auth setup-git || true
  echo "  gh: $(gh auth status 2>&1 | grep -m1 'Logged in' || echo ok)"
}

case "${1:-}" in
  -h|--help|"") usage 0 ;;

  install) install_op; exit 0 ;;

  check)
    need_op
    if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then echo "auth:  service account token"
    else echo "auth:  user account (op will prompt; put a service-account token in $TOKEN_FILE to avoid that)"; fi
    op whoami || die "op is not authenticated"
    [ -r "$REFS" ] && echo "refs:  $(ref_lines | wc -l | tr -d ' ') in $REFS" || echo "refs:  none ($REFS missing)"
    ;;

  ls|list)
    need_refs
    ref_lines | sed 's/=/ -> /'
    ;;

  get)
    need_op; need_refs
    name="${2:?usage: secrets get <NAME>}"
    ref="$(ref_for "$name")" || die "no ref named '$name' in $REFS"
    op read "$ref"
    ;;

  run)
    need_op; need_refs
    shift
    [ "${1:-}" = "--" ] && shift
    [ $# -ge 1 ] || die "usage: secrets run -- <command> [args…]"
    exec op run --env-file="$REFS" -- "$@"
    ;;

  shell)
    need_op; need_refs
    echo "==> secrets: subshell with $(ref_lines | wc -l | tr -d ' ') refs exported (exit to drop them)"
    exec op run --env-file="$REFS" -- "${SHELL:-/bin/sh}"
    ;;

  export)
    need_op; need_refs
    # For `eval "$(secrets export)"`. Values land in your interactive environment and
    # get inherited by everything you start from it — prefer `secrets run`.
    echo "secrets: values will stay in this shell's environment; prefer 'secrets run'" >&2
    # Here-string, not a pipe: a `while` on the right of a pipe runs in a subshell,
    # where die() could not stop the caller and a failed read would emit export NAME=''.
    while IFS='=' read -r name ref; do
      val="$(op read "$ref")" || die "could not read $ref"
      printf 'export %s=%q\n' "$name" "$val"
    done <<< "$(ref_lines)"
    ;;

  login)
    need_op; need_refs
    case "${2:-all}" in
      atuin) login_atuin ;;
      gh)    login_gh ;;
      all)   login_atuin; login_gh ;;
      *)     die "unknown target '$2' (atuin|gh|all)" ;;
    esac
    # Fold the fresh credential files into the shared store, so the next VM starts
    # out logged in and this whole dance happens once rather than per VM.
    [ -x "$HOME/.local/bin/dotenv-persist" ] && "$HOME/.local/bin/dotenv-persist" link || true
    ;;

  *) die "unknown command '$1' (try: secrets --help)" ;;
esac
