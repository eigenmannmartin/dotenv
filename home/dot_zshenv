# Read by EVERY zsh — interactive or not, login or not. Nothing else is.
#
# That is the whole point of this file: `ssh vm claude`, `limactl shell vm codex` and
# any other "run one command remotely" invocation runs neither .zprofile nor .zshrc,
# so a tool installed under ~/.local/bin is simply not found. npm's prefix here is
# ~/.local (set by the package script, so global installs need no root), which is
# where claude and codex land — and on Linux `ip`, needed by `cisco-vpn status`,
# lives in /usr/sbin, which a non-login shell also misses.
#
# Keep this file tiny and free of side effects: it runs for every zsh script too.
# .zprofile does not repeat these: on macOS /etc/zprofile runs path_helper after this
# file, which reorders PATH but keeps ~/.local/bin in it, so a re-add there would be
# a no-op.

case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# sbin on Linux. Lima also appends exactly this to ~/.zshrc on every VM ("Lima
# BEGIN/END", for iptables + mount.fuse3) — but chezmoi owns ~/.zshrc and overwrites
# it on the next apply, silently dropping those tools off PATH and leaving an endless
# "has changed since chezmoi last wrote it" conflict. Owning the setting here makes
# chezmoi's overwrite lossless.
if [[ "$OSTYPE" == linux* ]]; then
  case ":$PATH:" in *":/usr/sbin:"*) ;; *) export PATH="$PATH:/usr/sbin:/sbin" ;; esac
fi

# Homebrew's bin, for the same reason ~/.local/bin is here: `ssh mac 'fvm …'` from a
# Lima VM runs neither .zprofile nor path_helper, so everything brew installs is
# missing from exactly the invocations the VM uses to drive this machine. A literal
# path rather than `brew shellenv`, so no subprocess runs in every zsh script.
if [ -d /opt/homebrew/bin ]; then
  case ":$PATH:" in *":/opt/homebrew/bin:"*) ;; *) export PATH="/opt/homebrew/bin:$PATH" ;; esac
fi

# xcode-select points at CommandLineTools and switching needs sudo; DEVELOPER_DIR is
# the sudo-free override that lets `xcrun simctl` find the simulator tools — over ssh
# too, which is why it lives here and not in .zprofile.
if [ -z "${DEVELOPER_DIR:-}" ] && [ -d /Applications/Xcode.app/Contents/Developer ]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi
